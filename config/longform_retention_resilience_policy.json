{
  "schema_version": "longform-retention-resilience-v1",
  "effective_date_jst": "2026-09-15",
  "status": "ENFORCED_LONGFORM_DELTA",
  "purpose": "Keep 8-12 minute explainers substantive and make long-running AI/media work observable, resumable and idempotent without replacing the existing Scene -> Validate -> Checkpoint -> Join backbone.",
  "extends": ["config/longform_video_objectives.json", "config/longform_video_reliability_policy.json", "config/media_user_visual_duration_preferences.json"],
  "evidence_review": {
    "chatgpt_primary_source_review_completed": true,
    "deepseek_second_pass_run_id": 34956391997,
    "deepseek_artifact_id": 10390299884,
    "deepseek_artifact_digest": "sha256:33db07ec844275755fae52fcb0e99a259af8913f4bab301524bed006f961208a",
    "deepseek_report_is_advisory_not_authority": true,
    "chatgpt_final_adjudication_completed": true,
    "human_review_doc": "docs/LONGFORM_RETENTION_RESILIENCE_REVIEW_2026-09-15.md"
  },
  "editorial": {
    "normal_news_topic_target_minutes": [8, 12],
    "soft_envelope_not_padding_quota": true,
    "shorter_allowed_when_substantive_material_is_insufficient": true,
    "longer_requires_substantive_value": true,
    "durability_thresholds_must_not_be_derived_from_video_duration": true,
    "forbidden_padding": ["irrelevant history for runtime", "repeated framing without new information", "slow narration for runtime", "low-information filler", "unrelated tangents"],
    "beat_value_gate_required_before_script_lock": true,
    "each_major_beat_contributes_one_or_more": ["mechanism", "stakeholder impact", "new verified evidence", "material uncertainty", "credible competing interpretation", "necessary directly relevant context", "next watchpoint or material unresolved question"],
    "one_sentence_viewer_takeaway_per_major_segment": true,
    "duplicate_explanation_without_new_value": "REMOVE_OR_MERGE",
    "fixed_chapter_count": false,
    "attention_reset_is_editorial_not_motion_quota": true
  },
  "retention_learning": {
    "use_observed_platform_analytics_when_available": true,
    "metrics": ["averageViewDuration", "averageViewPercentage", "retention_curve", "top_moments", "spikes", "dips"],
    "compare_similar_format_and_duration_when_possible": true,
    "map_dips_and_spikes_to_beats_when_possible": true,
    "missing_analytics_are_unknown_not_zero": true,
    "fixed_universal_retention_percentage_gate": false,
    "fixed_universal_cut_interval": false,
    "single_video_causal_claim_without_experiment": false,
    "controlled_thumbnail_comparison_preferred_when_available": true
  },
  "durability_backbone": {
    "keep": ["Scene -> Validate -> Checkpoint -> Join", "atomic scene promotion", "content-addressed manifests as correctness authority", "bounded class-specific retries", "ffprobe and decode final gate"],
    "no_per_shot_or_per_frame_checkpoint_without_measured_recovery_gap": true,
    "no_monolithic_longform_render": true,
    "no_new_database_lock_service_or_coordinator_by_default": true
  },
  "heartbeat": {
    "required_for_long_running_execution": true,
    "role": "OBSERVABILITY_ONLY_NOT_CORRECTNESS_SOURCE",
    "update_on": ["PRECHECK", "SCENE_EXECUTING", "SCENE_VALIDATED", "CHECKPOINTED", "JOIN_PENDING", "JOINED", "FINAL_VALIDATED", "BLOCKED_OR_FAILED"],
    "minimum_fields": ["run_id", "thread_id", "stage", "scene_id_when_applicable", "updated_at", "attempt", "failure_class_when_applicable", "last_good_checkpoint_ref"],
    "stall_threshold_seconds": "CALIBRATE_BY_STAGE_BEFORE_HARD_GATE",
    "must_never_override_manifest_or_validator": true
  },
  "idempotency_and_single_writer": {
    "boundary_key_formula": "SHA256(thread_id|stage_name|ordered_input_content_hashes)",
    "pass_provider_idempotency_token_when_supported": true,
    "when_provider_lacks_token": "CHECK_CONTENT_ADDRESSED_OUTPUT_OR_RECEIPT_BEFORE_REINVOKE",
    "duplicate_side_effect_target": 0,
    "exactly_one_writer_per_mutable_scene_target_and_thread_id": true,
    "promotion_requires_validation_and_matching_input_manifest": true,
    "concurrent_stale_writer_promotion": "REJECT"
  },
  "failure_classes": {
    "TRANSIENT_NETWORK": "BOUNDED_BACKOFF_WITH_JITTER_THEN_BLOCK_PRESERVE",
    "RATE_LIMIT": "HONOR_RETRY_AFTER_ELSE_BOUNDED_BACKOFF_THEN_BLOCK_PRESERVE",
    "PROVIDER_5XX": "BOUNDED_BACKOFF_WITH_JITTER_THEN_BLOCK_PRESERVE",
    "CONTENT_OR_MEDIA_CONTRACT_FAIL": "NO_IDENTICAL_RETRY_REPAIR_SMALLEST_INPUT_OR_BLOCK",
    "DETERMINISTIC_BUG": "NO_IDENTICAL_RETRY_REPLAN_OR_PATCH_THEN_REVALIDATE",
    "RIGHTS_OR_FACT_GATE_FAIL": "NO_BLIND_RETRY_BLOCK_OR_FIND_NEW_EVIDENCE",
    "UNKNOWN_COST_OR_PAID_TRANSITION": "FAIL_CLOSED"
  },
  "circuit_breaker": {
    "concept_adopted": true,
    "hard_numeric_threshold_adopted": false,
    "threshold_requires_fixture_calibration": true,
    "trigger_shape": "REPEATED_CONSECUTIVE_SAME_CLASS_TERMINAL_FAILURES_WITHIN_BOUNDED_WINDOW",
    "on_trigger": ["stop new scene starts", "emit BLOCKED heartbeat", "preserve verified scenes and manifests", "resume from first incomplete unit after cause changes"],
    "auto_paid_fallback": false
  },
  "resume_and_done": {
    "conversation_memory_is_not_source_of_truth": true,
    "derive_cross_session_handoff_from_existing_manifests_at_read_time": true,
    "handoff_is_not_second_correctness_authority": true,
    "derived_handoff_fields": ["run_id", "thread_id", "last_good_checkpoint", "completed_scene_ids_and_hashes", "open_failures_and_class", "next_intended_action"],
    "resume_target": "FIRST_INCOMPLETE_OR_INVALID_UNIT",
    "rerender_completed_valid_scene_target": 0,
    "completed_verified_scenes_survive_later_failure": true,
    "join_must_not_use_partial_or_unverified_scene": true,
    "timer_is_not_completion_evidence": true,
    "done_requires": ["all required scenes promoted with matching manifests", "join success", "final ffprobe/media contract pass", "final decode pass", "subtitle coverage pass", "final visual rereview pass"]
  },
  "final_visual_rereview": {
    "required": true,
    "decode_pass_alone_is_not_visual_pass": true,
    "checks": ["white caption body text", "Zundamon bright green caption frame/accent", "Shikoku Metan bright pink/magenta caption frame/accent", "no unintended whole-diagram vertical drift", "character/speaker emphasis stays inside safe zones", "no corrupted representative frames", "no obvious A/V/subtitle drift"],
    "visual_preferences_are_not_claimed_as_proven_retention_causes": true
  },
  "anti_fragmentation": {
    "default_research_script_pair": ["ChatGPT", "DeepSeek"],
    "no_routine_research_writer_rewriter_reviewer_fanout": true,
    "deterministic_render_and_machine_qa_use_tools": true,
    "additional_agent_requires_material_information_gain_or_missing_specialist_capability": true
  },
  "measure_before_hard_promotion": ["value-gate effect", "beat-retention mapping", "heartbeat stall latency and false positives", "idempotency duplicate-side-effect test", "cache-cleared checkpoint validity", "circuit-breaker calibration", "cross-session resume", "single-writer concurrency"],
  "rejected": ["fixed retention percentage gates", "fixed cut intervals or mandatory motion", "per-shot/per-frame checkpointing without evidence", "cache hit as checkpoint proof", "unbounded retries", "generic paid fallback or auto top-up", "monolithic render", "extra reviewer agents without material gain", "new lock service/database without demonstrated need", "timer-based completion"],
  "sources": [
