{
  "schema_version": "current-media-execution-state-v1",
  "effective_date_jst": "2026-09-13",
  "status": "HOLD_MEDIA_PRODUCTION_UNTIL_EXPLICIT_USER_RELEASE",
  "source_of_truth": "repository",
  "purpose": "Preserve the user's current instruction not to produce media while allowing research, critique, policy work and planning. Keep this state separate from permanent creative standards so an explicit future production instruction can release the hold without deleting the creative rules.",
  "hold_scope": [
    "IMAGE_GENERATION",
    "VOICE_GENERATION",
    "VIDEO_RENDER",
    "FINAL_MEDIA_EXPORT",
    "MEDIA_PUBLICATION"
  ],
  "allowed_while_hold": [
    "RESEARCH",
    "REFERENCE_ANALYSIS",
    "CREATIVE_DIRECTION",
    "SCRIPT_OR_SHOT_PLAN_DRAFTING",
    "RIGHTS_AND_LICENSE_RESEARCH",
    "MEDIA_POLICY_MAINTENANCE",
    "NON_MEDIA_REPOSITORY_POLICY_UPDATES"
  ],
  "release_rule": {
    "explicit_user_instruction_required": true,
    "examples": [
      "制作して",
      "動画を作って",
      "レンダリングして",
      "音声を生成して",
      "画像を生成して"
    ],
    "release_is_task_scoped_unless_user_explicitly_changes_the_default": true,
    "implicit_context_or_old_plan_does_not_release_hold": true
  },
  "publication_rule": {
    "public_publish_still_requires_separate_human_approval": true
  },
  "cross_session": {
    "must_be_read_by_media_command_gate": true,
    "conversation_memory_alone_is_not_sufficient": true
  }
}
