{
  "schema_version": "media-source-policy-v1",
  "default_visual_mode": "REAL_PHOTO_SEARCH",
  "generated_images_enabled_by_default": false,
  "generated_video_enabled_by_default": false,
  "policy": {
    "prefer_real_photos_for_news": true,
    "search_first": true,
    "source_page_required": true,
    "asset_locator_required": true,
    "allowed_asset_hosts": [
      "commons.wikimedia.org",
      "upload.wikimedia.org"
    ],
    "author_required_when_license_requires_attribution": true,
    "license_required": true,
    "unknown_rights_blocked": true,
    "watermarked_assets_blocked": true,
    "news_agency_photo_reuse_blocked_without_explicit_license": true,
    "editorial_context_only_for_public_figure_photos": true,
    "asset_download_does_not_publish": true,
    "publish_requires_rights_manifest": true,
    "generic_paid_stock_fallback": false,
    "auto_purchase_stock": false
  },
  "preferred_sources": [
    "WIKIMEDIA_COMMONS",
    "UNSPLASH_VERIFIED_TERMS",
    "PEXELS_VERIFIED_TERMS"
  ],
  "preferred_licenses": [
    "CC0-1.0",
    "CC-BY-2.0",
    "CC-BY-3.0",
    "CC-BY-4.0"
  ],
  "conditionally_allowed_licenses": [
    "CC-BY-SA-3.0",
    "CC-BY-SA-4.0"
  ],
  "blocked_license_states": [
    "UNKNOWN",
    "ALL_RIGHTS_RESERVED",
    "EDITORIAL_ONLY_UNVERIFIED",
    "NONCOMMERCIAL_ONLY",
    "NO_DERIVATIVES"
  ],
