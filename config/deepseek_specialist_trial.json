{
  "schema_version": "deepseek-specialist-trial-v1",
  "provider_id": "deepseek",
  "display_name": "DeepSeek direct API",
  "base_url": "https://api.deepseek.com",
  "api_key_env": "DEEPSEEK_API_KEY",
  "model": "deepseek-flash",
  "model_family": "DeepSeek-V4.1-Flash",
  "scope": "STAGING_TRIAL_ONLY",
  "production_enabled": false,
  "generic_paid_fallback": false,
  "auto_top_up": false,
  "explicit_paid_trial_approved": true,
  "routing": {
    "rank": "PAID_ENGINEERING_SPECIALIST",
    "preferred_capabilities": [
      "CODING_DEEP",
      "DEBUGGING",
      "CODE_REVIEW",
      "ARCHITECTURE"
    ],
    "do_not_use_for": [
      "BULK",
      "DOCUMENTATION",
      "CLASSIFICATION",
      "SIMPLE_TEST",
      "TRIVIAL"
    ],
    "selection_policy": "USE_WHEN_HIGH_DIFFICULTY_OR_CRITICAL_PATH_OR_FREE_WORKER_FAILED",
    "free_workers_remain_default": true,
    "nvidia_remains_final_commander": true
  },
  "trial_budget": {
    "max_calls": 6,
    "max_parallel_calls": 2,
    "max_estimated_cost_usd": 0.25,
    "stop_before_estimated_budget_exceeded": true,
    "max_output_tokens_per_call": 4096
  },
  "pricing": {
    "currency": "USD",
    "dashboard_current_off_peak_per_million": {
      "prompt_cache_hit": 0.003,
      "prompt_cache_miss": 0.15,
      "output": 0.6
    },
    "dashboard_peak_multiplier": 2.0,
    "conservative_budget_guard_per_million": {
      "prompt_cache_hit": 0.014,
      "prompt_cache_miss": 0.44,
      "output": 1.32
    },
    "note": "Budget guard intentionally uses conservative peak-equivalent public rates even when the authenticated dashboard shows lower V4.1 pricing."
  },
  "reasoning": {
    "CODING_DEEP": "high",
    "DEBUGGING": "high",
    "CODE_REVIEW": "low",
    "ARCHITECTURE": "high",
    "TEST_STRATEGY": "low",
    "INTEGRATION_REVIEW": "low"
  },
  "safety_boundary": {
    "repository_write": false,
    "deploy": false,
    "publish": false,
    "production_routing": false,
    "secret_output": false,
    "paid_route_is_explicit_not_fallback": true
  }
}
