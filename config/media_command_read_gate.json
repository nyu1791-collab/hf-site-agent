{
  "schema_version": "media-command-read-gate-v5",
  "effective_date_jst": "2026-09-13",
  "status": "ENFORCED_STANDARD",
  "purpose": "Force repository-backed media know-how restoration, measurement, untrusted-content security, claim provenance, experiment-validity, audio/BGM/SFX rules, character motion/prosody rules, and executable artifact-contract rules before any video, clipping/repurposing, or TikTok Shop media task, including after chat-tab/session changes.",
  "source_of_truth": "repository",
  "semantic_triggering": {
    "exact_keyword_match_required": false,
    "classify_by_user_intent": true,
    "mixed_intents_are_additive": true,
    "examples": {
      "VIDEO_CREATION": ["動画を作って", "動画制作して", "ショートを作って", "ニュース動画にして", "MP4にして"],
      "CLIPPING_REPURPOSING": ["切り抜いて", "クリップ化して", "Shorts向けに抜き出して", "再編集して", "ハイライトにして"],
      "TIKTOK_SHOP_COMMERCE": ["TikTok Shop動画を作って", "商品紹介動画にして", "売れる商品動画を作って", "TikTokショップ用にして"]
    }
  },
  "execution_gate": {
    "must_complete_before": ["PLANNING_MEDIA_PIPELINE", "EXTERNAL_MEDIA_TOOL_CALL", "ASSET_FETCH", "VOICE_GENERATION", "RENDER", "PUBLISHING_HANDOFF"],
    "must_not_claim_gate_complete_without_reading_required_repository_sources": true,
    "conversation_memory_alone_is_insufficient": true,
    "tab_or_session_change_does_not_waive_gate": true,
    "measurement_plan_required_for_optimization_claim": true,
    "claim_ledger_required_when_second_pass_policy_marks_claim_type_in_scope": true,
    "machine_contracts_required_when_untrusted_claim_or_experiment_artifacts_are_used": true,
    "user_explicit_instruction_may_change_output_goal_but_does_not_silently_disable_safety_cost_or_rights_rules": true
  },
  "common_media_read_set": [
    "config/current_commander_handoff.json",
    "config/permanent_standards_manifest.json",
    "config/media_audio_motion_retention_policy.json",
    "config/free_audio_source_registry.json",
    "config/dova_curated_bgm_catalog.json",
    "config/cross_source_knowhow_evidence_matrix.json",
    "config/cross_domain_measurement_registry.json",
    "config/cross_source_second_pass_policy.json",
    "config/second_pass_artifact_contracts.json",
    "docs/CROSS_SOURCE_KNOWHOW_ADJUDICATION_2026-09-13.md",
    "docs/CROSS_SOURCE_SECOND_PASS_2026-09-13.md",
    "docs/MEDIA_PIPELINE.md",
    "config/longform_video_objectives.json",
    "config/longform_video_reliability_policy.json",
    "docs/LONGFORM_VIDEO_RELIABILITY_PLAYBOOK.md",
    "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
  ],
  "trigger_read_sets": {
    "VIDEO_CREATION": {
      "inherits": ["common_media_read_set"],
      "required": ["docs/LONGFORM_VIDEO_OBJECTIVES.md"],
      "apply_when": "The requested deliverable is a new video/MP4/Short/long-form media artifact, including news/explainer/product video."
    },
    "CLIPPING_REPURPOSING": {
      "inherits": ["common_media_read_set"],
      "required": ["config/authorized_clipping_monetization_policy.json", "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md", "config/batch_media_orchestration_policy.json", "docs/BATCH_MEDIA_ORCHESTRATION.md", "docs/MEDIA_BATCH_COMMAND_CENTER.md"],
      "apply_when": "The user asks to cut, clip, highlight, reframe, repurpose, remix, or transform existing media."
    },
    "TIKTOK_SHOP_COMMERCE": {
      "inherits": ["common_media_read_set"],
      "required": ["config/tiktok_shop_influence_policy.json", "docs/TIKTOK_SHOP_INFLUENCE_PLAYBOOK.md"],
      "conditional_required": {
        "if_existing_or_third_party_media_is_repurposed": ["config/authorized_clipping_monetization_policy.json", "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md"]
      },
      "apply_when": "The task is a TikTok Shop/product-commerce video, script, edit, cover, caption, or conversion-focused media plan."
    }
  },
