{
  "schema_version": "media-command-read-gate-v10",
  "effective_date_jst": "2026-09-14",
  "status": "ENFORCED_STANDARD",
  "decision_owner": "chatgpt-top-commander",
  "purpose": "RESTORE_ONLY_CURRENT_INTENT_RELEVANT_MEDIA_KNOW_HOW_THEN_PARALLELIZE_INDEPENDENT_WORK_WITH_SINGLE_WRITER_INTEGRATION",
  "source_of_truth": "CURRENT_REPOSITORY_AT_EXACT_HEAD",
  "semantic_triggering": {
    "classify_by_meaning_not_literal_keywords": true,
    "mixed_intents_are_additive": true,
    "compound_shop_clipping_must_expand_to_both_shop_and_clipping": true,
    "supported_intents": ["VIDEO_CREATION", "CLIPPING_REPURPOSING", "TIKTOK_SHOP_COMMERCE"]
  },
  "execution_gate": {
    "must_resolve_required_read_set_before_planning": true,
    "must_finish_required_read_set_before_external_side_effects": true,
    "must_use_current_repository_versions": true,
    "stale_summary_cannot_replace_repository_policy": true,
    "machine_policy_overrides_conflicting_human_prose": true,
    "missing_required_file": "BLOCK_RELEVANT_MEDIA_EXECUTION"
  },
  "knowledge_restore_execution": {
    "resolve_required_paths_as_union": true,
    "deduplicate_paths_before_read": true,
    "repository_reads_may_run_in_parallel": true,
    "max_parallel_repository_reads": 4,
    "machine_policies_before_human_playbooks": true,
    "exact_same_head_and_blob_cache_allowed": true,
    "cache_scope": "ACTIVE_MEDIA_TASK_OR_SESSION",
    "cache_key_fields": ["repository", "head_sha", "path", "blob_sha"],
    "invalidate_cache_on_head_or_blob_change": true,
    "do_not_open_same_blob_twice_in_one_gate_run": true,
    "longform_sources_only_when_longform_intent": true,
    "claim_governance_only_when_claim_bearing_or_commerce_or_current_factual": true,
    "shop_clipping_must_union_shop_and_clipping_knowhow": true
  },
  "common_media_read_set": [
    "config/current_commander_handoff.json",
    "config/permanent_standards_manifest.json",
    "docs/AI_ARMY_MASTER_RULEBOOK.md",
    "config/multi_agent_operating_policy.json",
    "config/agent_efficiency_policy.json",
    "config/media_audio_motion_retention_policy.json",
    "config/media_reusable_asset_standard.json",
    "config/media_character_reaction_cache_policy.json",
    "docs/ZUNDAMON_METAN_REACTION_AND_SUBTITLE_STANDARD.md",
    "config/free_audio_source_registry.json",
    "config/dova_curated_bgm_catalog.json",
    "docs/MEDIA_PIPELINE.md"
  ],
  "trigger_sets": {
    "VIDEO_CREATION": {
      "required": ["config/media_source_policy.json"],
      "conditional": {
        "if_longform": [
          "config/longform_video_objectives.json",
          "config/longform_video_reliability_policy.json",
          "docs/LONGFORM_VIDEO_OBJECTIVES.md",
          "docs/LONGFORM_VIDEO_RELIABILITY_PLAYBOOK.md",
          "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
        ],
        "if_claim_bearing_or_current_factual_content": [
          "config/cross_source_knowhow_evidence_matrix.json",
          "config/cross_domain_measurement_registry.json",
          "config/cross_source_second_pass_policy.json",
          "config/second_pass_artifact_contracts.json",
          "docs/CROSS_SOURCE_KNOWHOW_ADJUDICATION_2026-09-13.md",
          "docs/CROSS_SOURCE_SECOND_PASS_2026-09-13.md"
        ]
      }
    },
    "CLIPPING_REPURPOSING": {
      "required": [
        "config/authorized_clipping_monetization_policy.json",
        "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md",
        "config/batch_media_orchestration_policy.json",
        "docs/BATCH_MEDIA_ORCHESTRATION.md",
        "docs/MEDIA_BATCH_COMMAND_CENTER.md",
        "config/media_source_policy.json"
      ],
      "conditional": {
        "if_claim_bearing_or_current_factual_content": [
          "config/cross_source_knowhow_evidence_matrix.json",
          "config/cross_domain_measurement_registry.json",
          "config/cross_source_second_pass_policy.json",
          "config/second_pass_artifact_contracts.json"
        ]
      }
    },
    "TIKTOK_SHOP_COMMERCE": {
      "required": [
        "config/tiktok_shop_influence_policy.json",
        "docs/TIKTOK_SHOP_INFLUENCE_PLAYBOOK.md",
        "config/cross_source_knowhow_evidence_matrix.json",
        "config/cross_domain_measurement_registry.json",
        "config/cross_source_second_pass_policy.json",
        "config/second_pass_artifact_contracts.json",
        "config/media_source_policy.json"
      ],
      "conditional": {
        "if_existing_or_third_party_media_is_repurposed": [
          "config/authorized_clipping_monetization_policy.json",
          "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md",
          "config/batch_media_orchestration_policy.json",
          "docs/BATCH_MEDIA_ORCHESTRATION.md",
          "docs/MEDIA_BATCH_COMMAND_CENTER.md"
        ]
      }
    }
  },
  "mixed_intent_expansions": {
    "SHOP_CLIPPING": ["TIKTOK_SHOP_COMMERCE", "CLIPPING_REPURPOSING"],
    "SHOP_VIDEO": ["TIKTOK_SHOP_COMMERCE", "VIDEO_CREATION"],
    "SHOP_CLIPPING_VIDEO": ["TIKTOK_SHOP_COMMERCE", "CLIPPING_REPURPOSING", "VIDEO_CREATION"]
  },
  "parallel_execution_standard": {
    "independent_read_only_lanes_may_start_concurrently": true,
    "independent_media_jobs_may_start_concurrently_after_admission": true,
    "max_direct_parallel_corps": 3,
    "dependency_join_required": true,
    "same_mutable_output_requires_single_writer": true,
    "rights_and_claim_gates_cannot_be_skipped_for_speed": true,
    "deterministic_mechanical_work_prefers_tools_over_agent_debate": true,
    "duplicate_agents_for_majority_vote_by_default": false,
    "backpressure_must_reduce_parallelism_before_quality_gates": true,
    "recommended_independent_lanes": [
      "source_and_fact_research",
      "rights_and_claim_verification",
      "edit_and_caption_planning",
      "deterministic_automation_planning"
    ]
  },
  "know_how_that_must_be_recovered": {
    "common": [
      "ChatGPT remains final commander and integrator",
      "parallelize only independent work; join dependencies explicitly",
      "single writer owns each mutable output",
      "current media creative policy controls YMM4-or-equivalent visible behavior, VOICEVOX timing, character motion and captions",
      "reusable registered assets are resolved cache-first before search, while rights and semantic fit remain mandatory",
      "Zundamon and Metan reaction assets are downloaded once, preprocessed into a verified local reaction pack, and reused without per-video search or download",
      "character motion must include expression, pose, lateral, scale, tilt, focus or reaction-state changes; vertical bounce alone is insufficient",
      "VOICEVOX pronunciation text is separate from on-screen caption text; English brand and technical terms use official Latin spelling in captions by default",
      "character size, position and recurring motion come from deterministic presets rather than per-video reinvention or motion downloads",
      "machine validators outrank model votes"
    ],
    "video_creation": [
      "search is discovery, not a license",
      "check the reusable asset registry and verified cache before new search or download",
      "resolve the Zundamon/Metan reaction pack before character rendering and load its inventory once per render",
      "use rights-verified real or official visuals by default",
      "measure actual audio duration and align captions to audio boundaries",
      "keep katakana pronunciation in voice_text while using official English spelling in caption_text for English proper nouns and technical terms",
      "longform-only reliability material is loaded only for longform work"
    ],
    "clipping_repurposing": [
      "source rights and platform monetization eligibility are separate gates",
      "ASR/alignment, candidate scoring, duplicate suppression, sentence boundaries, reframe, captions and machine QA form the clipping pipeline",
      "known TTS timing may bypass unnecessary ASR",
      "mechanical trim/cut/concat/reframe/caption burn/ffprobe work is deterministic rather than multi-agent debate"
    ],
    "tiktok_shop_commerce": [
      "ingest and verify product-page evidence before final script claims",
      "map every material product claim to evidence",
      "reverify volatile price, coupon, stock and shipping claims near publish time",
      "persona and purchase motive are hypotheses to test, not invented facts",
      "hooks and creative variants are experiments with measurable outcomes"
    ]
  },
  "forbidden_shortcuts": [
    "SKIP_REQUIRED_INTENT_PLAYBOOK",
    "SHOP_CLIP_WITHOUT_BOTH_SHOP_AND_CLIPPING_KNOWHOW",
    "LOAD_LONGFORM_STACK_FOR_EVERY_SHORTFORM_TASK",
    "REOPEN_IDENTICAL_BLOB_REPEATEDLY_IN_ONE_GATE_RUN",
    "RESEARCH_REGISTERED_REUSABLE_ASSET_AGAIN_BEFORE_CHECKING_CACHE",
    "REDOWNLOAD_VERIFIED_CACHED_ASSET_WITHOUT_REASON",
    "SEARCH_OR_DOWNLOAD_ZUNDAMON_METAN_REACTION_ASSETS_PER_VIDEO",
    "USE_VERTICAL_BOUNCE_AS_ONLY_CHARACTER_MOTION",
    "COPY_KATAKANA_TTS_READING_DIRECTLY_TO_ENGLISH_CAPTION_TERM",
    "DOWNLOAD_CHARACTER_MOTION_INSTEAD_OF_USING_PRESET",
    "REINVENT_STANDARD_CHARACTER_SIZE_OR_POSITION_EVERY_VIDEO",
    "PARALLEL_WRITE_TO_SAME_OUTPUT",
    "RIGHTS_GATE_BYPASS_FOR_SPEED",
    "CLAIM_GATE_BYPASS_FOR_SPEED",
    "MULTI_AGENT_DEBATE_FOR_DETERMINISTIC_MEDIA_STAGES",
    "USE_RETIRED_SHORTFORM_EDIT_PROFILE",
    "TREAT_SEARCH_RESULT_AS_LICENSE",
    "AUTO_PAID_FALLBACK"
  ],
  "retired_references": {
    "forbidden_paths": ["config/shortform_edit_profile.json"],
    "reason": "SUPERSEDED_BY_MEDIA_AUDIO_MOTION_RETENTION_POLICY_AND_INTENT_SPECIFIC_PLAYBOOKS"
  },
  "new_session_behavior": {
    "permanent_manifest_must_point_to_this_policy": true,
    "media_task_must_re_read_current_repository_versions": true,
    "master_rulebook_must_be_re_read": true,
    "media_pipeline_must_be_re_read": true,
    "audio_motion_retention_policy_must_be_re_read": true,
    "reusable_asset_standard_must_be_re_read": true,
    "character_reaction_cache_policy_must_be_re_read": true,
    "reaction_subtitle_human_standard_must_be_re_read": true,
    "free_audio_source_registry_must_be_re_read": true,
    "dova_curated_bgm_catalog_must_be_re_read": true,
    "do_not_rely_on_prior_tab_summary_as_substitute": true,
    "exact_same_head_and_blob_cache_may_satisfy_repeat_read_within_active_task": true
  }
}
