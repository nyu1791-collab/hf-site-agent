{
  "schema_version": "free-execution-guard-v1",
  "effective_date_jst": "2026-10-02",
  "status": "ENFORCED_PERMANENT_STANDARD",
  "decision_owner": "chatgpt-top-commander",
  "purpose": "Keep general paid API candidates evidence-gated and keep paid video/image/TTS generation, fallback, top-up and public posting blocked, while allowing the user's exact DeepSeek V4.1 Flash text-only RSS script exception within fixed cost caps.",
  "default_runtime": {
    "free_only_mode": false,
    "allow_paid_model": true,
    "allow_paid_fallback": false,
    "auto_top_up": false,
    "unknown_cost_route": "BLOCK",
    "trial_credit_or_freemium_route_counts_as_free": false,
    "billing_or_upgrade_page_is_not_an_execution_step": true,
    "paid_route_must_not_be_probed_to_discover_availability": true,
    "paid_route_eligibility_policy": "config/paid_agent_route_eligibility_policy.json",
    "paid_route_requires_verified_lower_total_cost_and_materially_better_task_performance": true
  },
  "media_boundary": {
    "paid_or_freemium_video_generation": false,
    "paid_or_freemium_video_editing": false,
    "paid_caption_or_tts_service": false,
    "paid_media_tool_discovery": false,
    "permitted_default": "LOCAL_OR_FRESHLY_VERIFIED_ZERO_COST_ROUTE",
    "permitted_tools": [
      "Python",
      "Pillow",
      "FFmpeg",
      "ffprobe",
      "VOICEVOX_LOCAL",
      "YMM4_LOCAL"
    ],
    "blocked_tools": [
      "runway",
      "fal",
      "fal.ai",
      "descript",
      "veed",
      "heygen",
      "higgsfield"
    ],
    "free_route_unavailable_action": "BLOCK_AND_REPORT_NO_PAID_SUBSTITUTION"
  },
  "video_creation_admission": {
    "policy": "config/video_creation_admission_policy.json",
    "runtime": "scripts/video_creation_admission.py",
    "must_restore_before_every_video_request": true,
    "required_local_engine": "VOICEVOX_LOCAL",
    "required_primary_voice": "ずんだもん",
    "required_secondary_voice_when_dialogue_helps": "四国めたん",
    "voicevox_runtime_probe_required": true,
    "voicevox_unavailable_action": "BLOCK_BEFORE_RENDER",
    "silent_video_fallback": false,
    "actual_wav_duration_drives_timeline": true,
    "runtime_bootstrap_policy": "config/video_creation_admission_policy.json",
    "start_local_engine_before_blocking": true,
    "runtime_bootstrap_document": "docs/VOICEVOX_RUNTIME.md",
    "runtime_launcher": "scripts/with_local_voicevox.sh"
  },
  "narrow_preauthorized_exceptions": {
    "jev": {
      "enabled": true,
      "policy": "config/jev_decision_engine_policy.json",
      "scope": "TYPED_FAST_DECISION_ONLY",
      "media_generation": false,
      "other_paid_provider_authorization": false
    },
    "deepseek": {
      "enabled_only_when_current_policy_scope_matches": true,
      "policy": "config/deepseek_paid_supervisor_policy.json",
      "media_generation": false,
      "other_paid_provider_authorization": false
    },
    "resident_news_script": {
      "enabled": true,
      "provider": "openrouter",
      "exact_model": "deepseek/deepseek-v4.1-flash",
      "scope": "RSS_NEWS_SCRIPT_DRAFTING_TEXT_ONLY",
      "policy": "config/media_news_pipeline_policy.json#/paid_script_generation",
      "runtime": "scripts/media_news_pipeline.py",
      "per_call_estimate_cap_usd": "0.05",
      "reserved_daily_cost_cap_usd": "0.10",
      "max_paid_calls_per_utc_day": 5,
      "exact_free_review_policy": "config/media_news_pipeline_policy.json#/free_script_review",
      "paid_fallback": false,
      "provider_fallback": false,
      "paid_sibling_substitution": false,
      "auto_top_up": false,
      "paid_video_or_image_generation": false,
      "paid_tts_or_editing": false,
      "auto_publish": false,
      "reserved_monthly_cost_cap_usd": "0.50",
      "monthly_budget_boundary": "UTC_CALENDAR_MONTH",
      "budget_applies_to": "ALL_RESERVED_CALLS_FOR_THIS_RESIDENT_NEWS_ROUTE",
      "user_instruction_date_jst": "2026-10-02"
    }
  },
  "cross_tab_continuity": {
    "must_be_read_from_repository_on_new_tab": true,
    "must_be_re_read_when_media_intent_is_detected": true,
    "chat_memory_cannot_override_this_guard": true,
    "paid_api_route_eligibility_survives_tab_change": true,
    "paid_media_block_survives_tab_change": true,
    "upgrade_or_billing_prompt_must_not_be_treated_as_permission": true,
    "paid_api_route_gate_survives_tab_change": true,
    "resident_news_deepseek_route_survives_tab_change": true,
    "evidence_gated_paid_route_survives_tab_change": true
  },
  "failure_contract": {
    "blocked_paid_route_is_not_a_failed_free_route": true,
    "must_report_block_reason": true,
    "must_not_retry_same_paid_route": true,
    "must_not_silently_switch_to_paid": true
  },
  "gated_paid_api_model_routes": {
    "enabled": true,
    "policy": "config/paid_agent_route_eligibility_policy.json",
    "runtime": "scripts/paid_agent_route_policy.py",
    "eligible_as_primary_only_after_evidence_gate": true,
    "all_unknown_evidence_blocks": true,
    "paid_fallback": false,
    "auto_top_up": false
  }
}
