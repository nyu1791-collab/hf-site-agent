{
  "schema_version": "media-news-pipeline-v2",
  "status": "GCP_COORDINATOR_REPOSITORY_CONFIGURED_LIVE_E2E_VERIFICATION_REQUIRED",
  "purpose": "Turn one official RSS item into a source-backed Japanese script, VOICEVOX audio, and fast source-attributed visuals. License metadata is optional; rendering requires traceable source attribution and file-integrity checks.",
  "source_ingress_policy": "config/media_source_ingress_policy.json",
  "article_hosts": [
    "openai.com",
    "www.openai.com",
    "deepmind.google"
  ],
  "poll_interval_seconds": 300,
  "voice_retry": {
    "maximum_attempts": 3,
    "retry_delays_seconds": [
      60,
      300
    ],
    "state_after_exhaustion": "VOICE_BLOCKED",
    "manual_requeue_command": "python -m scripts.media_news_pipeline --db <queue.db> --workspace <workspace> retry-voice --source-id <source_id>"
  },
  "voice_checkpoint": {
    "reuse_audio_and_timing_when_hashes_match": true,
    "optional_expected_engine_version_environment": "VOICEVOX_EXPECTED_VERSION",
    "persistent_wav_cache_environment": "VOICEVOX_CACHE_DIR",
    "remote_voicevox_environment": "VOICEVOX_REMOTE_TUNNEL=1",
    "remote_url_must_be_loopback_http": true
  },
  "resource_backpressure": {
    "maximum_unresolved_packages_per_queue": 1,
    "pause_states": [
      "VOICE_BLOCKED",
      "ASSET_REVIEW_REQUIRED",
      "NO_CLEARED_IMAGES"
    ],
    "minimum_workspace_free_bytes": 2147483648,
    "automatic_artifact_deletion": false,
    "pause_before_new_api_or_voice_work": true
  },
  "daily_openrouter_media_call_cap": 20,
  "at_daily_cap": "LEAVE_ITEM_QUEUED_FOR_NEXT_UTC_DAY",
  "generic_openrouter_free_router_allowed": false,
  "provider_fallback_allowed": true,
  "auto_top_up": false,
  "default_duration_seconds": [
    60,
    300
  ],
  "max_article_bytes": 1500000,
  "max_article_characters": 32000,
  "max_article_images": 8,
  "max_article_image_bytes": 5000000,
  "image_hosts": [
    "openai.com",
    "www.openai.com",
    "cdn.openai.com",
    "images.ctfassets.net",
    "deepmind.google"
  ],
  "scene_count": [
    3,
    4
  ],
  "distinct_rights_cleared_images_per_scene": 2,
  "downloaded_image_rights_default": "SOURCE_ATTRIBUTION_REQUIRED",
  "render_requires_rights_basis_credit_and_https_evidence_url": false,
  "remote_render_policy": "config/media_render_worker_policy.json",
  "remote_render_requires_explicit_command_flag": true,
  "remote_render_auto_fallback_or_retry": false,
  "default_voice_cast": [
    "ずんだもん",
    "四国めたん"
  ],
  "generated_images_allowed": true,
  "public_publish_enabled": false,
  "stop_state_before_rights_review": "ASSET_REVIEW_REQUIRED",
  "one_pipeline_command_per_queue": true,
  "source_id_format": "LOWERCASE_SHA256_HEX_64",
  "article_source_fingerprint": "URL_TITLE_TEXT_AND_IMAGE_URLS_SHA256",
  "atomic_checkpoint_writes": true,
  "preserve_rights_review_for_unchanged_source": true,
  "resume_existing_script_before_new_model_call": true,
  "render_revalidates_package_path_and_asset_sha256": true,
  "paid_script_generation": {
    "enabled": true,
    "provider": "deepseek_official",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-flash",
    "scope": "OFFICIAL_RSS_NEWS_SCRIPT_DRAFTING_ONLY_TEXT_API",
    "route_selection": "DIRECT_OFFICIAL_DEEPSEEK_API_ONLY",
    "maximum_completion_tokens": 5000,
    "input_token_overhead": 2048,
    "pricing_source": "https://api-docs.deepseek.com/quick_start/pricing/",
    "pricing_verified_at_utc": "2026-10-03",
    "peak_input_usd_per_million_tokens": "0.30",
    "peak_cache_hit_usd_per_million_tokens": "0.006",
    "peak_output_usd_per_million_tokens": "1.20",
    "price_basis": "PEAK_RATE_UPPER_BOUND_FOR_ESTIMATES; PROVIDER_BILLING_IS_ACTUAL",
    "artificial_per_call_cap_usd": null,
    "artificial_daily_cap_usd": null,
    "artificial_monthly_cap_usd": null,
    "artificial_daily_call_cap": null,
    "require_actual_usage_cost": false,
    "usage_cost_reported_by_provider": false,
    "usage_telemetry": "provider_model_timestamp_request_count_input_output_cache_estimate_actual_status_retry_count",
    "automatic_paid_fallback": false,
    "automatic_retry_after_unknown_result": false,
    "max_explicit_429_retries": 1,
    "retry_429_only": true,
    "automatic_top_up": false,
    "reserve_before_request": true,
    "per_source_paid_attempt_once": true,
    "persist_model_price_usage_and_cost_evidence": true,
    "balance_exhaustion_state": "BLOCKED_BALANCE",
    "unknown_outcome_state": "UNKNOWN_RESULT"
  },
  "free_script_review": {
    "enabled": false,
    "provider": "openrouter",
    "route_requirement": "EXACT_ZERO_COST_FREE_MODEL_ONLY",
    "model_id_must_end_with": ":free",
    "require_current_catalog": true,
    "require_exact_zero_prompt_and_completion_price": true,
    "require_reported_usage_cost_zero": true,
    "maximum_calls_per_utc_day": 5,
    "maximum_completion_tokens": 1200,
    "advisory_only": true,
    "may_rewrite_script": false,
    "may_block_paid_script": false,
    "if_unavailable": "RECORD_SKIPPED_AND_KEEP_PAID_SCRIPT",
    "disabled_reason": "FREE_ROUTE_IS_PRIMARY_SCRIPT_ROUTE"
  },
  "unicode_recovery": {
    "recovery_version": "unicode-stdio-v1",
    "requeue_legacy_unicodeencodeerror_once": true,
    "never_repeat_if_paid_call_was_reserved": true,
    "preserve_previous_block_record": true,
    "child_python_environment": "UTF8_BACKSLASHREPLACE"
  },
  "primary_script_route": "OPENROUTER_FREE_THEN_DEEPSEEK_OFFICIAL",
  "free_review_is_optional_advisory_only": true,
  "remote_render_required_for_final_video_completion": true,
  "openrouter_routing": {
    "free_only": true,
    "paid_models_allowed": false,
    "paid_fallback_allowed": false,
    "allowed_model_rule": "EXACT_COLON_FREE_ID_OR_CURRENT_CATALOG_ZERO_PROMPT_AND_COMPLETION_PRICE; GENERIC_OPENROUTER_FREE_ROUTER_BLOCKED",
    "generic_router_allowed": false,
    "unverified_model_action": "BLOCKED_UNVERIFIED_PRICE_BEFORE_REQUEST",
    "free_unavailable_action": "FALL_BACK_ONLY_TO_DEEPSEEK_OFFICIAL_API",
    "daily_call_cap": 20,
    "429_policy": "EXPONENTIAL_BACKOFF_WITHOUT_PAID_OPENROUTER_FALLBACK",
    "paid_model_action": "BLOCKED_PAID_OPENROUTER_BEFORE_REQUEST",
    "catalog_cache_ttl_seconds": 300,
    "catalog_expired_fetch_failure_action": "BLOCKED_UNVERIFIED_PRICE"
  },
  "free_script_generation": {
    "enabled": true,
    "provider": "openrouter",
    "route_requirement": "SHARED_OPENROUTER_FREE_GATE",
    "model_id_must_end_with": null,
    "generic_router_allowed": false,
    "maximum_calls_per_utc_day": 20,
    "maximum_completion_tokens": 1200,
    "if_unavailable": "FALL_BACK_TO_DEEPSEEK_OFFICIAL_API",
    "automatic_paid_openrouter_fallback": false,
    "provider_allow_fallbacks": false
  },
  "artificial_paid_caps_removed_for": "DEEPSEEK_OFFICIAL_ONLY",
  "distinct_visuals_per_scene": 2,
  "render_requires_source_credit_and_https_source_url": true,
  "visual_source_policy": {
    "profile": "FAST_SOURCE_ATTRIBUTION",
    "license_metadata_required_for_render": false,
    "per_image_license_lookup_required": false,
    "source_url_required": true,
    "source_credit_required": true,
    "source_attribution_rendered_on_video": true,
    "allowed_modes": [
      "LICENSE_CLEARED",
      "OFFICIAL_ARTICLE_IMAGE",
      "OFFICIAL_ANNOUNCEMENT_SCREENSHOT",
      "SOURCE_BACKED_WEB_IMAGE",
      "USER_PROVIDED_SOURCE_SCREENSHOT",
      "GENERATED_WITH_PROVENANCE"
    ],
    "official_social_post_screenshot_allowed": true,
    "official_x_post_screenshot_allowed": true,
    "whole_post_screenshot_allowed_for_official_announcement": true,
    "arbitrary_public_https_image_download_allowed": true,
    "private_or_loopback_url_blocked": true,
    "local_file_import_allowed": true,
    "supported_raster_types": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "maximum_source_visual_bytes": 5000000,
    "minimum_required_checks": [
      "REGULAR_FILE_NOT_SYMLINK",
      "SUPPORTED_RASTER_MAGIC",
      "BOUNDED_BYTES",
      "SHA256_MATCH",
      "HTTPS_SOURCE_URL_NO_CREDENTIALS",
      "NONEMPTY_SOURCE_CREDIT"
    ]
  }
}
