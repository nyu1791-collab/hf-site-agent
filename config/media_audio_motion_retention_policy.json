{
  "schema_version": "media-audio-motion-retention-v5",
  "effective_date_jst": "2026-09-14",
  "status": "ENFORCED_STANDARD",
  "purpose": "Make free background music, sound effects, VOICEVOX cast/prosody, actual character presence and motion, YMM4-style Zundamon/Metan editing, caption hierarchy, search-collected contextual visuals, attention choreography and anti-boredom editing defaults recoverable and executable across future media tasks without requiring the user to restate them.",
  "applies_to": ["VIDEO_CREATION", "SHORTS", "LONGFORM", "NEWS_EXPLAINER", "TIKTOK_SHOP_COMMERCE", "CLIPPING_REPURPOSING"],
  "semantic_default": {
    "auto_apply_on_media_intent": true,
    "user_does_not_need_to_repeat_rules": true,
    "explicit_user_override_allowed": true,
    "safety_rights_cost_rules_cannot_be_silently_disabled": true,
    "blanket_media_production_hold_is_not_a_default_rule": true
  },
  "authority_and_references": {
    "free_audio_source_registry": "config/free_audio_source_registry.json",
    "dova_curated_bgm_catalog": "config/dova_curated_bgm_catalog.json",
    "media_command_read_gate": "config/media_command_read_gate.json",
    "longform_reliability_policy": "config/longform_video_reliability_policy.json",
    "master_rulebook": "docs/AI_ARMY_MASTER_RULEBOOK.md",
    "conversation_memory_is_not_source_of_truth": true
  },
  "free_only_audio": {
    "paid_music_or_sfx_services": false,
    "auto_purchase": false,
    "auto_subscription": false,
    "paid_fallback": false,
    "unknown_or_unverifiable_license": "BLOCK",
    "random_free_music_from_unverified_channels": "BLOCK",
    "license_evidence_required_before_use": true,
    "cache_downloaded_assets_with_provenance": true,
    "do_not_redistribute_raw_third_party_audio": true
  },
  "editing_tool_policy": {
    "default_path": "LOCAL_OR_VERIFIED_COMPLETELY_FREE",
    "preferred_character_editing_environment": "YMM4",
    "preferred_voice_integration": "YMM4_WITH_VOICEVOX",
    "local_tools": ["YMM4", "VOICEVOX", "FFmpeg", "ffprobe", "Python", "Pillow", "OpenCV", "MoviePy", "ASS_SUBTITLES"],
    "ymm4_unavailable_behavior": "USE_DETERMINISTIC_EQUIVALENT_ONLY_IF_IT_REPRODUCES_THE_REQUIRED_LIPSYNC_BLINK_BOUNCE_FOCUS_EXPRESSION_AND_CAPTION_CONTRACT",
    "paid_video_editing_apps_or_sites_allowed": false,
    "paid_caption_apps_or_sites_allowed": false,
    "freemium_or_trial_credit_video_editing_allowed": false,
    "freemium_or_trial_credit_captioning_allowed": false,
    "temporary_free_promotion_is_not_a_free_route": true,
    "external_ai_caption_or_editing_tool_requires_verified_zero_cost_without_paid_transition": true,
    "unknown_cost_or_future_paid_transition": "BLOCK"
  },
  "visual_asset_acquisition": {
    "generated_image_assets_allowed": false,
    "generated_video_assets_allowed": false,
    "generated_background_images_allowed": false,
    "default_mode": "SEARCH_DISCOVER_THEN_VERIFY_AND_MATERIALIZE",
    "news_background_default_mode": "SEARCH_COLLECTED_RIGHTS_VERIFIED_REAL_OR_OFFICIAL_VISUAL",
    "search_engine_result_is_discovery_not_license": true,
    "prefer_primary_or_official_visuals_for_factual_claims": true,
    "rights_cleared_illustrative_visuals_allowed": true,
    "original_source_and_reuse_terms_must_be_verified": true,
    "pre_download_before_render": true,
    "decode_validate_before_render": true,
    "single_bad_asset_must_not_restart_unrelated_scenes": true,
    "news_background_must_semantically_match_current_narration_or_claim": true,
    "audio_waveform_or_voice_visualizer_is_not_default_background": true
  },
  "audio_asset_pool": {
    "goal": "Maintain a broad reusable pool so each video can choose a small coherent subset instead of reusing the same sounds mechanically.",
    "minimum_pool_targets_before_scale": {
      "bgm_tracks_total": 18,
      "sfx_total": 48,
      "bgm_moods": ["neutral_tech", "bright", "calm", "curious", "suspense", "serious", "urgent", "warm"],
      "sfx_categories": ["entry", "pop", "click", "whoosh", "impact", "reveal", "number", "warning", "transition", "soft_chime", "comedy", "confirmation", "error", "silence_marker"]
    },
    "selection_rules": [
      "Do not use every available sound in one video.",
      "Choose one dominant BGM mood per semantic segment and switch only at meaningful story boundaries.",
      "Rotate tracks across videos with a cooldown to reduce audible repetition.",
      "Reserve distinctive SFX for stable semantic meanings so the audience learns the audio grammar.",
      "Use silence as an intentional audio event when it improves contrast or gravity."
    ]
  },
  "audio_mix": {
    "narration_is_primary": true,
    "bgm_must_not_mask_speech": true,
    "sfx_must_not_mask_key_words": true,
    "automatic_or_keyframed_ducking_under_speech": true,
    "bgm_level_starting_heuristic_relative_to_narration_lu": [-20, -12],
    "sfx_level_starting_heuristic_relative_to_narration_db": [-12, -6],
    "heuristics_are_not_universal_mastering_targets": true,
    "measure_integrated_loudness_true_peak_clipping_and_silence": true,
    "prefer_short_fades_and_crossfades_over_hard_audio_edges": true,
    "serious_or_sensitive_topic_can_disable_comedic_sfx_or_upbeat_bgm": true,
    "keep_intelligibility_over_energy": true
  },
  "sound_grammar": {
    "ENTRY": "First appearance or chapter re-entry of a speaker/character.",
    "EVIDENCE": "Reveal of a primary source, official document, chart or proof frame.",
    "NUMBER": "A number that materially changes understanding.",
    "REVEAL": "A factual reversal, correction or unexpected conclusion.",
    "WARNING": "Risk, caveat, contradiction or important limitation.",
    "TRANSITION": "Semantic section change, not every cut.",
    "COMEDY": "Light reaction only when the topic permits it.",
    "CONFIRMATION": "Resolved point or verified conclusion.",
    "SILENCE": "Deliberate absence of BGM/SFX to create contrast before or after an important beat."
  },
  "voice_prosody": {
    "default_engine": "VOICEVOX_LOCAL",
    "durable_standard_cast": ["ずんだもん", "四国めたん"],
    "default_primary_voice": "ずんだもん",
    "secondary_voice_when_dialogue_helps": "四国めたん",
    "both_voices_are_first_class_supported_narrators": true,
    "runtime_discover_styles_and_ids": true,
    "do_not_hardcode_stale_style_ids": true,
    "allowed_query_adjustments": ["speedScale", "pitchScale", "intonationScale", "volumeScale", "pause_length", "interrogative_upspeak", "accent_phrase_adjustment"],
    "emotion_tags": ["neutral", "curious", "surprised", "serious", "warning", "excited", "skeptical", "relieved", "sad_or_grave"],
    "rules": [
      "Map emotion to voice parameters deliberately instead of using one flat preset for the entire video.",
      "Change prosody at semantic beats, not every word.",
      "Use punctuation and pause design to improve phrasing before extreme parameter changes.",
      "Match stronger prosody to meaningful emphasis, question, surprise, warning, correction, payoff or emotional turn.",
      "Avoid cartoonishly strong pitch or speed changes during serious news, disasters, death, injury or corrections.",
      "Measure actual WAV duration with ffprobe after every generated chunk and drive caption/video timing from that duration."
    ]
  },
  "character_direction": {
    "default_role_split_is_experiment_not_universal_law": true,
    "zundamon_default_role": ["audience_proxy", "curiosity", "question", "reaction", "emotion"],
    "shikoku_metan_default_role": ["explainer", "correction", "fact_structure", "clarification"],
    "role_reversal_allowed_when_story_reason_exists": true,
    "stable_anchor_position_is_preferred_for_longform_explainers": true,
    "fixed_screen_side_is_starting_experiment_not_permanent_truth": true,
    "active_speaker_priority": "speaker > semantic focal > non-speaker reaction",
    "two_character_large_frame_is_exception": ["opening", "closing", "conflict", "comedy", "summary"],
    "serious_news_restraint_overrides_comedy": true,
    "standard_cast_actual_character_visuals_required_when_series_or_task_uses_them": true,
    "voice_waveform_or_audio_visualizer_cannot_substitute_for_character_presence": true,
    "placeholder_voice_panel_cannot_substitute_for_character_presence": true,
    "temporary_character_hide_or_reduction_allowed_when_evidence_or_caption_is_primary_hero": true
  },
  "character_motion": {
    "no_long_static_talking_portrait": true,
    "motion_is_state_driven": true,
    "stable_anchor_does_not_mean_frozen_character": true,
    "speaker_states": ["idle", "speaking", "reaction", "emphasis", "enter", "exit", "grave_mode"],
    "recommended_micro_motion": ["blink", "subtle_bob", "small_scale_pulse", "expression_swap", "head_or_body_tilt_if_asset_allows", "short_entry_or_exit_motion"],
    "active_speaker_emphasis": true,
    "inactive_speaker_should_not_compete": true,
    "inactive_speaker_options": ["slightly_smaller", "slightly_dimmer", "reaction_expression", "temporary_hide_for_evidence_frame"],
    "entry_exit_rule": "Use full entrance/exit mainly for first appearance, scene reset, major section change, or evidence-focus handoff; do not enter/exit on every line.",
    "pose_change_rule": "Change expression/pose on semantic beats, not per syllable or every caption.",
    "avoid_constant_large_motion": true,
    "avoid_every_line_full_entry_exit": true,
    "motion_must_not_cover_captions_or_evidence": true,
    "serious_topic_reduces_comedic_motion": true,
    "visible_standard_cast_characters_require_state_driven_motion_or_expression_change": true
  },
  "zundamon_metan_editing_profile": {
    "status": "MANDATORY_SERIES_STANDARD",
    "applies_when": "ZUNDAMON_OR_SHIKOKU_METAN_IS_USED_AS_A_VISIBLE_OR_SPEAKING_CHARACTER",
    "authoring_environment": {
      "preferred_editor": "YMM4",
      "voice_engine": "VOICEVOX",
      "ymm4_voicevox_link_for_automatic_lipsync": true,
      "automatic_mouth_animation_required": true,
      "automatic_blink_required": true,
      "character_assets_must_support_mouth_and_eye_state_changes": true,
      "non_ymm4_fallback_must_reproduce_same_visible_behavior": true
    },
    "speech_start_bounce": {
      "required": true,
      "trigger": "START_OF_EACH_SPEAKING_TURN",
      "axis": "Y_AND_SCALE",
      "scale_sequence": [1.0, 1.05, 1.0],
      "vertical_bounce_required": true,
      "easing_required": true,
      "rule": "Use a short bounce at speech onset; do not keep the character continuously bouncing during the whole line."
    },
    "speaker_focus_switch": {
      "required": true,
      "active_speaker": {
        "scale": 1.05,
        "brightness_percent": 100,
        "z_order": "FRONTMOST_CHARACTER"
      },
      "inactive_listener": {
        "scale": 1.0,
        "brightness_percent": 80,
        "z_order": "BEHIND_ACTIVE_SPEAKER"
      },
      "switch_on_voice_turn": true,
      "focus_change_must_follow_audio_turn_timing": true
    },
    "expression_and_pose": {
      "change_every_sentence_count_range": [1, 2],
      "emotion_mapped_expression_required": true,
      "pose_change_when_semantically_useful": true,
      "reaction_symbols": ["sweat_mark", "anger_mark", "question_mark", "surprise_mark", "emphasis_symbol"],
      "reaction_symbols_should_be_added_frequently_when_semantically_appropriate": true,
      "sensitive_topic_mode_may_suppress_comedic_symbols": true
    },
    "caption_professional_style": {
      "preferred_fonts_in_order": ["ラグランパンチ", "キルゴシック", "源ノ角ゴシック Heavy", "源ノ角ゴシック Bold", "コーポレート・ロゴ"],
      "fallback_font_rule": "USE_HEAVY_OR_BOLD_JAPANESE_GOTHIC_IF_PREFERRED_FONT_IS_UNAVAILABLE",
      "base_text_color": "#FFFFFF",
      "double_outline_required": true,
      "inner_outline": {
        "color": "#000000",
        "width_px_range": [3, 5]
      },
      "outer_outline": {
        "width_px_range": [6, 10],
        "color_source": "CURRENT_SPEAKER_CHARACTER_COLOR"
      },
      "character_theme_colors": {
        "ずんだもん": "#8BC34A",
        "四国めたん": "#E91E63"
      },
      "emphasis_word_colors": ["#FFEB3B", "#F44336"],
      "emphasis_word_scale": 1.2,
      "caption_backplate_required": true,
      "caption_backplate_options": ["ROUNDED_SEMITRANSPARENT_BLACK_BOX", "CURRENT_SPEAKER_CHARACTER_COLOR_BAND"],
      "max_characters_per_line": 15,
      "preferred_characters_per_line_range": [13, 15],
      "line_break_must_respect_semantic_phrase_boundary_when_possible": true,
      "timing_source": "VOICE_AUDIO_BOUNDARY",
      "timing_precision": "MILLISECOND_LEVEL",
      "caption_start_must_match_speech_start": true,
      "caption_switch_must_match_voice_turn_or_phrase_change": true
    },
    "hard_fail_conditions": [
      "VISIBLE_CHARACTER_WITHOUT_MOUTH_ANIMATION_WHEN_SPEAKING",
      "VISIBLE_CHARACTER_WITHOUT_BLINK_OR_EQUIVALENT_EYE_MOTION_OVER_EXTENDED_APPEARANCE",
      "NO_SPEECH_START_BOUNCE",
      "ACTIVE_AND_INACTIVE_CHARACTERS_HAVE_SAME_VISUAL_FOCUS_WITHOUT_REASON",
      "NO_EXPRESSION_CHANGE_ACROSS_MORE_THAN_TWO_SENTENCES_WHEN_CHARACTER_REMAINS_VISIBLE",
      "CAPTION_LINE_EXCEEDS_15_CHARACTERS_WITHOUT_UNBREAKABLE_PROPER_NOUN_REASON",
      "CAPTION_TIMING_IS_ESTIMATED_FROM_TEXT_LENGTH_INSTEAD_OF_AUDIO_TIMING",
      "SINGLE_OUTLINE_ONLY_WHEN_DOUBLE_OUTLINE_IS_SUPPORTED",
      "CHARACTER_THEME_COLOR_NOT_REFLECTED_IN_OUTER_CAPTION_OUTLINE_OR_EQUIVALENT_SPEAKER_CUE"
    ]
  },
  "caption_grammar": {
    "captions_are_attention_ui_not_transcript_dump": true,
    "full_narration_coverage_required": true,
    "full_spoken_text_contract": "FULL_SPOKEN_TEXT",
    "summary_caption_may_not_replace_narration": true,
    "speaker_colored_caption_text_required": true,
    "important_term_emphasis_colors": ["#FFEB3B", "#F44336"],
    "default_lines_per_block": "1_OR_2",
    "semantic_chunking_required": true,
    "longform_structural_hierarchy": ["title", "chapter", "subheading", "body"],
    "emphasis_hierarchy_levels": ["baseline", "emphasis", "peak"],
    "baseline_should_already_be_large_on_phone": true,
    "one_strongest_keyword_or_phrase_per_beat_by_default": true,
    "emphasis_can_use": ["size", "weight", "color"],
    "do_not_encode_meaning_by_color_alone": true,
    "consistent_semantic_color_mapping_across_series_is_preferred": true,
    "no_word_by_word_bounce_as_default": true,
    "no_background_prose_or_headline_wall": true,
    "small_source_or_attribution_strip_is_allowed_as_metadata": true,
    "platform_safe_zone_must_be_checked": true,
    "caption_character_safe_area_required": true
  },
  "contextual_visuals": {
    "background_text_is_not_the_default_visual": true,
    "switch_on_semantic_triggers": ["new_entity_or_person_or_place", "claim_to_evidence", "important_number_or_stat", "contrast_or_reversal", "outcome_or_conclusion"],
    "no_universal_switch_every_n_seconds_rule": true,
    "evidence_vs_illustration_must_be_labeled": true,
    "EVIDENCE": "Primary/official/source material directly tied to a claim.",
    "ILLUSTRATIVE": "Rights-cleared representative image or B-roll that must not be presented as proof.",
    "search_engine_result_is_discovery_not_license": true,
    "final_asset_requires_original_source_and_reuse_terms_verification": true,
    "asset_ledger_fields": ["original_url", "asset_title", "creator_or_source", "license_and_url", "attribution", "retrieval_date", "transformation_notes", "evidence_or_illustrative", "verification_timestamp"],
    "still_image_motion_when_helpful": ["slow_push", "pan", "crop_reveal", "parallax_like_layer_motion", "highlight_box", "pointer_or_focus_mask"],
    "news_backgrounds_prefer_search_collected_real_or_official_images_over_abstract_generated_visuals": true,
    "audio_visualizer_is_not_a_semantic_news_background": true
  },
  "visual_attention_hierarchy": {
    "one_primary_hero_per_beat": true,
    "hero_candidates": ["evidence_image", "character", "emphasis_caption", "important_number"],
    "supporting_elements_must_be_visually_subordinate": true,
    "no_motion_for_motion_sake": true,
    "scene_change_interval_is_not_fixed": true,
    "change_visuals_on_semantic_events": true
  },
  "anti_boredom_patterns": {
    "allowed": ["question_answer_turns", "evidence_reveal", "before_after_or_claim_reality_contrast", "micro_pattern_interrupt", "change_of_visual_hero", "short_silence_before_reveal", "camera_or_crop_motion_on_still_evidence", "speaker_emotion_change", "caption_hierarchy_change", "semantic_transition", "recap_or_payoff"],
    "forbidden_default": ["constant_zoom", "sound_effect_on_every_cut", "animated_every_word", "random_transition_pack_usage", "both_characters_large_at_all_times", "background_text_wall", "unrelated_stock_visuals_for_primary_claims", "rapid_bgm_switching_without_story_reason", "flat_voice_for_entire_video", "long_static_talking_portrait", "voice_waveform_as_character_substitute", "audio_visualizer_as_default_news_background"]
  },
  "collision_avoidance": {
    "max_attention_dominant_elements_per_beat": 1,
    "if_emphasis_caption_is_dominant_reduce_character_motion": true,
    "if_evidence_image_is_dominant_reduce_character_size_and_sfx_density": true,
    "if_voice_emotion_is_high_reduce_bgm_and_visual_effect_intensity": true,
    "if_major_sfx_hits_duck_bgm_temporarily": true,
    "if_character_entry_is_hero_reduce_caption_pop_and_zoom": true,
    "never_stack_major_sfx_major_zoom_major_caption_pop_and_character_entry_without_explicit_reason": true
  },
  "sensitive_topic_mode": {
    "triggers": ["death", "disaster", "major_accident", "victim_harm", "war_casualties", "medical_emergency", "correction_of_harmful_falsehood"],
    "disable_or_reduce": ["comedy_sfx", "bouncy_motion", "celebratory_bgm", "exaggerated_voice_pitch", "meme_reaction"],
    "prefer": ["neutral_or_grave_bgm_or_silence", "restrained_motion", "clear_evidence", "calm_prosody"]
  },
  "originality_and_series_identity": {
    "stable_series_elements": ["character_identity", "typography_system", "semantic_color_system", "sound_grammar", "broad_layout_language"],
    "episode_specific_elements": ["hook", "story", "evidence", "image_sequence", "dialogue_shape", "conclusion"],
    "do_not_mass_produce_same_template_with_only_nouns_swapped": true,
    "substantive_original_commentary_required_for_originality_goal": true
  },
  "evaluation": {
    "machine_qa": ["caption_coverage", "decode_errors", "audio_presence", "integrated_loudness", "true_peak", "clipping", "unexpected_silence", "safe_zone_collision", "asset_license_manifest_complete", "required_character_presence", "character_motion_present_when_required", "voice_waveform_not_used_as_character_substitute", "news_background_source_and_semantic_match", "ymm4_or_equivalent_lipsync_present", "blink_present", "speech_start_bounce_present", "speaker_focus_switch_present", "expression_change_cadence", "double_outline_caption_style", "caption_max_15_characters_per_line", "caption_audio_boundary_sync_ms"],
    "viewer_metrics_when_available": ["stayed_to_watch_or_viewed_vs_swiped", "average_view_duration", "average_percentage_viewed", "retention_dips", "retention_spikes", "rewatch_or_loop_behavior", "shares", "saves_or_equivalent", "comments"],
    "a_b_testing_rule": "Change one primary creative variable per test where practical; do not claim causality from a single uncontrolled video.",
    "missing_analytics": "UNKNOWN_NOT_ZERO"
  },
  "durability": {
    "must_be_indexed_by_permanent_manifest": true,
    "must_be_required_by_media_command_read_gate": true,
    "must_be_re_read_after_new_tab_or_session": true,
    "chat_memory_alone_never_satisfies_restore": true
  },
  "publication": {
    "public_publish_requires_human_approval": true,
    "volatile_platform_audio_rights_recheck_at_publish_time": true,
    "attribution_text_must_be_preserved_when_required": true
  }
}
