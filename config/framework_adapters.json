{
  "schema_version": "framework-adapter-layer-v1",
  "native_router_authority": true,
  "default_adapter": "native",
  "fallback_adapter": "native",
  "policy": {
    "external_frameworks_are_execution_engines_only": true,
    "external_framework_may_replan_top_level_mission": false,
    "external_framework_may_change_model_budget": false,
    "external_framework_may_enable_paid_fallback": false,
    "external_framework_may_mutate_secrets": false,
    "external_framework_may_merge": false,
    "external_framework_may_deploy": false,
    "external_framework_may_publish": false,
    "external_framework_repository_write": false,
    "copilot_mutation_requires_human_approval": true,
    "native_fallback_required": true,
    "max_external_framework_hops": 1
  },
  "adapters": {
    "native": {
      "enabled": true,
      "kind": "native",
      "priority": 100,
      "capabilities": [
        "bounded_autonomy",
        "dag",
        "dependency_join",
        "free_only_routing",
        "idempotency",
        "checkpoint",
        "recovery",
        "task_profile_routing",
        "value_optimization"
      ],
      "work_types": ["*"]
    },
    "langgraph": {
      "enabled": true,
      "kind": "python_optional",
      "module": "langgraph",
      "priority": 92,
      "capabilities": [
        "stateful_workflow",
        "durable_execution",
        "conditional_graph",
        "human_in_loop",
        "checkpoint",
        "long_running_workflow",
        "parallel_branches"
      ],
      "work_types": [
        "LONG_RUNNING_WORKFLOW",
        "STATEFUL_PIPELINE",
        "RECOVERY_WORKFLOW",
        "COMPLEX_DAG",
        "MEDIA_PIPELINE"
      ]
    },
    "crewai": {
      "enabled": true,
      "kind": "python_optional",
      "module": "crewai",
      "priority": 86,
      "capabilities": [
        "role_based_team",
        "collaborative_agents",
        "hierarchical_process",
        "sequential_process",
        "research_team",
        "content_team"
      ],
      "work_types": [
        "RESEARCH",
        "CONTENT_PIPELINE",
        "NEWSROOM",
        "MARKET_RESEARCH",
        "MEDIA_PREPRODUCTION"
      ]
    },
    "autogen": {
      "enabled": true,
      "kind": "python_optional_any",
      "modules": ["autogen_agentchat", "autogen_core"],
      "priority": 84,
      "capabilities": [
        "multi_agent_chat",
        "selector_team",
        "swarm_team",
        "graph_flow",
        "code_review_team",
        "debate",
        "human_in_loop"
      ],
      "work_types": [
        "MULTI_AGENT_COUNCIL",
        "CODE_REVIEW",
        "DEBUGGING_COUNCIL",
        "ARCHITECTURE_REVIEW",
        "ADVERSARIAL_REVIEW"
      ]
    },
    "copilot": {
      "enabled": true,
      "kind": "external_guarded",
      "priority": 72,
      "capabilities": [
        "repository_context",
        "coding_agent",
        "multi_step_code_change",
        "terminal_assistance"
      ],
      "work_types": [
        "CODING",
        "TEST_REPAIR",
        "REFACTOR_PROPOSAL",
        "REPOSITORY_ANALYSIS"
      ],
      "proposal_only": true,
      "requires_explicit_runtime_enable": true,
      "runtime_enable_env": "COPILOT_FRAMEWORK_ADAPTER_ENABLED",
      "required_executable": "gh"
    }
  }
}
