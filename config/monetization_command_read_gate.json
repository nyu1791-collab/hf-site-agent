{
  "schema_version": "monetization-command-read-gate-v3",
  "effective_date_jst": "2026-09-15",
  "status": "ENFORCED_STANDARD",
  "purpose": "Force repository-backed monetization and platform-program know-how restoration before planning or executing creator-revenue, sponsorship, affiliate, membership, paid-research, AI-workflow client-service, lead-generation, licensing or productization tasks, including after chat-tab/session changes.",
  "source_of_truth": "repository",
  "semantic_triggering": {
    "exact_keyword_match_required": false,
    "classify_by_user_intent": true,
    "mixed_intents_are_additive": true,
    "generic_product_commerce_requires_target_platform_resolution": true,
    "platform_specific_commerce_rules_are_not_universal": true,
    "examples": ["収益化したい", "儲けたい", "案件を探して", "スポンサー案件", "ブランド案件", "アフィリエイト", "YouTubeで稼ぐ", "Instagramで稼ぐ", "TikTokで稼ぐ", "商品を紹介して売る", "ショッピング動画", "切り抜きで稼ぐ", "会員収益", "UGC案件", "SNS運用代行", "クライアント向け動画制作", "AI導入で稼ぐ", "AIエージェント案件", "有料ニュースレター", "調査レポートを売る", "リード獲得で稼ぐ", "案件運用を代行する", "テンプレートを売る", "Micro-SaaSにする"]
  },
  "execution_gate": {
    "must_complete_before": ["MONETIZATION_OPPORTUNITY_SELECTION", "REVENUE_FORECAST", "BRAND_OR_CLIENT_PITCH_PLANNING", "PLATFORM_PROGRAM_APPLICATION_PLANNING", "AFFILIATE_CONTENT_PLAN", "MEMBERSHIP_OR_SUBSCRIPTION_PLAN", "PAID_RESEARCH_OR_DIGITAL_PRODUCT_PLAN", "AI_WORKFLOW_CLIENT_SERVICE_PLAN", "LEAD_GENERATION_SERVICE_PLAN", "LICENSING_OR_PRODUCTIZATION_PLAN", "EXTERNAL_OUTREACH", "ACCOUNT_OR_PAYMENT_ACTION", "PUBLICATION_HANDOFF"],
    "conversation_memory_alone_is_insufficient": true,
    "tab_or_session_change_does_not_waive_gate": true,
    "current_platform_evidence_must_be_reverified_for_program_specific_action": true,
    "income_claim_must_not_be_presented_as_guaranteed": true,
    "platform_specific_terms_are_versioned_evidence_not_permanent_truth": true,
    "temporary_incentive_must_not_be_used_as_baseline_economics": true,
    "modeled_roi_must_not_be_presented_as_observed_client_savings": true
  },
  "required_read_set": [
    "config/current_commander_handoff.json",
    "config/permanent_standards_manifest.json",
    "docs/AI_ARMY_MASTER_RULEBOOK.md",
    "config/creator_monetization_policy.json",
    "config/monetization_opportunity_backlog.json",
    "config/platform_program_evidence.json",
    "docs/CREATOR_MONETIZATION_AND_AGENT_REVENUE_PLAYBOOK.md",
    "config/cross_source_knowhow_evidence_matrix.json",
    "config/cross_domain_measurement_registry.json",
    "config/cross_source_second_pass_policy.json",
    "config/second_pass_artifact_contracts.json"
  ],
  "conditional_read_sets": {
    "VIDEO_OR_SHORTFORM_CREATIVE": ["config/media_command_read_gate.json", "docs/MEDIA_PIPELINE.md", "config/longform_video_reliability_policy.json"],
    "TIKTOK_SHOP_OR_PRODUCT_COMMERCE": ["config/tiktok_shop_influence_policy.json", "docs/TIKTOK_SHOP_INFLUENCE_PLAYBOOK.md", "config/commerce_clipping_precision_overlay.json", "docs/COMMERCE_CLIPPING_PRECISION_REFRESH_2026-09-15.md", "config/platform_program_evidence.json"],
    "CLIPPING_OR_REPURPOSING": ["config/authorized_clipping_monetization_policy.json", "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md", "config/commerce_clipping_precision_overlay.json", "docs/COMMERCE_CLIPPING_PRECISION_REFRESH_2026-09-15.md"],
    "FACTUAL_NEWS_OR_PRODUCT_CLAIMS": ["schemas/claim_evidence_ledger.schema.json", "scripts/second_pass_governance.py"],
    "AI_WORKFLOW_OR_AGENT_SERVICE": ["config/multi_agent_operating_policy.json", "config/deepseek_paid_supervisor_policy.json", "config/agent_efficiency_policy.json", "config/cross_source_second_pass_policy.json"]
  },
  "commerce_platform_resolution": {
    "resolve_target_platform_before_platform_specific_commerce_advice": true,
    "tiktok_shop_specific_rules_only_when_tiktok_shop_or_semantically_applicable": true,
    "youtube_shopping_uses_current_platform_program_evidence": true,
    "unknown_target_platform_blocks_platform_specific_publish_assumptions": true,
    "cross_platform_claim_rights_disclosure_rules_still_apply_when_platform_unknown": true,
    "shop_plus_clipping_uses_union_of_both_read_sets": true,
    "paid_media_or_whitelisting_permission_is_separate_from_organic_posting_permission": true
  },
  "approval_rules": {
    "research_and_internal_ranking": "ALLOWED",
    "draft_pitch_or_offer": "ALLOWED",
    "send_pitch_or_outreach": "EXPLICIT_USER_OR_NAMED_HUMAN_APPROVAL_REQUIRED",
    "program_application": "EXPLICIT_USER_APPROVAL_REQUIRED",
    "contract_acceptance_or_rate_commitment": "HUMAN_APPROVAL_REQUIRED",
    "usage_rights_or_paid_media_commitment": "HUMAN_APPROVAL_REQUIRED",
    "client_production_side_effect_or_activation": "HUMAN_APPROVAL_REQUIRED",
    "public_post_or_publish": "HUMAN_APPROVAL_REQUIRED_UNLESS_SEPARATELY_AUTHORIZED",
    "mass_unsolicited_outreach": "PROHIBITED",
    "secret_or_identity_document_disclosure": "PROHIBITED"
  },
  "know_how_that_must_be_recovered": [
    "near_term_service_revenue_and_long_term_platform_revenue_are_separate_engines",
    "platform_native_payout_merchant_commission_brand_deal_service_and_recurring_revenue_must_not_be_mixed_unlabeled",
    "off_platform_creative_ugc_analytics_localization_social_ops_and_ai_workflow_integration_are_high_priority_near_term_cash_lanes",
    "permission_based_lead_generation_and_creator_campaign_operations_are_additional_service_lanes",
    "owned_asset_licensing_is_experimental_and_requires_real_rights_and_paid_demand",
    "micro_saas_is_watch_only_until_a_repeated_paid_workflow_proves_demand_and_support_economics",
    "prefer_high_judgment_business_outcomes_over_commoditized_low_complexity_ai_execution",
    "ai_workflow_service_requires_process_baseline_bounded_autonomy_least_privilege_human_control_and_measured_roi",
    "paid_research_newsletter_premium_intelligence_and_digital_products_are_experiment_lanes_when_real_paid_value_exists",
    "youtube_shopping_and_instagram_affiliate_tags_are_current_japan_opportunities_subject_to_reverification",
    "youtube_affiliate_partnerships_boost_is_optional_limited_amplification_and_temporary_bonus_is_not_baseline_economics",
    "creator_marketplaces_are_preferred_over_spam_outreach",
    "brand_deal_creative_fee_usage_rights_paid_media_territory_exclusivity_and_renewal_are_separate_commercial_dimensions",
    "do_not_silently_grant_perpetual_global_exclusive_usage_rights",
    "organic_posting_permission_and_paid_media_or_whitelisting_permission_are_separate_commercial_dimensions",
    "generic_product_commerce_must_resolve_target_platform_before_applying_platform_specific_rules",
    "shop_plus_clipping_must_restore_both_commerce_and_clipping_knowhow",
    "commercial_relationship_disclosure_and_claim_evidence_are_separate_blocking_checks_when_applicable",
    "platform_payout_programs_are_secondary_and_volatile_not_guaranteed_income",
    "distribution_reach_is_not_revenue_without_a_defined_monetized_destination_and_attribution",
    "originality_and_substantive_value_are_monetization_constraints",
    "x_original_content_rewards_must_not_use_automated_creation_or_posting",
    "mass_produced_repetitive_or_low_value_reposts_are_not_a_growth_strategy",
    "commercial_relationship_disclosure_and_claim_evidence_are_required",
    "observed_and_modeled_economics_are_separate",
    "human_approval_is_required_for_contract_send_apply_publish_usage_rights_client_activation_and_financial_commitments"
  ],
  "forbidden_shortcuts": [
    "SKIP_REPOSITORY_READ_BECAUSE_PRIOR_CHAT_ALREADY_DISCUSSSED_MONETIZATION",
    "SKIP_MASTER_RULEBOOK_AND_CURRENT_MANIFEST_ON_NEW_TAB",
    "ASSUME_PROGRAM_AVAILABILITY_OR_ELIGIBILITY_FROM_STALE_MEMORY",
    "TREAT_TIKTOK_SHOP_RULES_AS_UNIVERSAL_PRODUCT_COMMERCE_RULES",
    "SHOP_CLIPPING_WITHOUT_BOTH_COMMERCE_AND_CLIPPING_READ_SETS",
    "ASSUME_ORGANIC_POST_PERMISSION_EQUALS_PAID_MEDIA_PERMISSION",
    "TREAT_TEMPORARY_INCENTIVE_AS_BASELINE_ECONOMICS",
    "PROMISE_OR_GUARANTEE_INCOME",
    "PRESENT_MODELED_REVENUE_OR_ROI_AS_OBSERVED",
    "MASS_AUTO_POST_FOR_MONETIZATION",
    "MASS_UNSOLICITED_OUTREACH",
    "FAKE_ENGAGEMENT_OR_REVIEWS",
    "COPY_OR_MINIMALLY_EDIT_CONTENT_FOR_SCALE",
    "HIDE_AFFILIATE_OR_SPONSORED_RELATIONSHIP_WHEN_DISCLOSURE_REQUIRED",
    "BUILD_SPECULATIVE_MICRO_SAAS_BEFORE_PAID_DEMAND_VALIDATION",
    "AUTO_ACCEPT_CONTRACT_RATE_OR_USAGE_RIGHTS",
    "AUTO_APPLY_TO_PROGRAM_WITHOUT_USER_APPROVAL",
    "AUTO_ACTIVATE_CLIENT_PRODUCTION_SIDE_EFFECT_WITHOUT_AUTHORITY",
    "AUTO_PUBLISH_WITHOUT_REQUIRED_APPROVAL",
    "SELL_UNBOUNDED_AUTONOMOUS_AGENT_OPERATION_AS_DEFAULT"
  ],
  "new_session_behavior": {
    "permanent_manifest_must_point_to_this_policy": true,
    "permanent_manifest_must_point_to_master_rulebook": true,
    "current_commander_handoff_must_restore_permanent_manifest": true,
    "monetization_task_must_re_read_current_repository_versions": true,
    "commerce_or_clipping_task_must_re_read_precision_overlay": true,
    "do_not_rely_on_prior_tab_summary_as_substitute": true,
    "do_not_duplicate_entire_manifest_standard_list_into_commander_handoff": true
  }
}
