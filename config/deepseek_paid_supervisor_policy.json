    "other_paid_providers_remain_disallowed_without_explicit_user_authorization": true
  },
  "provider": {
    "id": "deepseek",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "primary_model": "deepseek-v4-flash",
