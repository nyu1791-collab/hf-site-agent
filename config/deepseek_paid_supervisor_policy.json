  "human_authorization": {
    "authorized": true,
    "persistent_for_allowed_scope": true,
    "authorized_by_user_on": "2026-09-12",
    "purpose": "Use paid DeepSeek heavily as a senior supervisor for research, architecture, peer review, decomposition, red-team analysis, incident diagnosis, media strategy, TikTok Shop strategy, and supervision of subordinate AI work.",
    "repeat_per_call_approval_required": false
  },
  "precedence": {
    "scope": "DEEPSEEK_PAID_SUPERVISORY_PATH_ONLY",
    "overrides_global_free_only_for_this_scope": true,
    "does_not_override": [
      "NO_AUTO_TOP_UP",
