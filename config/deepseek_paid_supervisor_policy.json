    "deepseek_reports_to": "chatgpt-work",
    "deepseek_is_lowest_worker": false,
    "deepseek_is_bulk_coding_worker": false,
    "deepseek_primary_duties": [
      "RESEARCH_DIRECTOR",
      "SYSTEM_ARCHITECT",
      "PEER_REVIEW_CHAIR",
      "RED_TEAM_CHAIR",
      "INCIDENT_COMMANDER",
      "MEDIA_STRATEGY_SUPERVISOR",
      "TIKTOK_SHOP_STRATEGY_SUPERVISOR",
      "SUBORDINATE_WORK_REVIEWER"
    ],
    "subordinate_execution_preference": [
      "DETERMINISTIC_TOOLS",
      "VERIFIED_FREE_OR_LOW_COST_SPECIALISTS",
      "VERIFIED_QWEN_OR_NVIDIA_OR_GROQ_OR_GOOGLE_SPECIALISTS",
      "OPENROUTER_FREE_WORKERS_WHEN_VERIFIED"
    ],
    "subordinate_route_must_be_verified_before_use": true,
    "if_no_subordinate_route_is_verified": "DEEPSEEK_MAY_COMPLETE_ANALYSIS_ITSELF_WITHIN_BUDGET"
  },
  "usage_policy": {
    "spend_compute_on": [
      "broad_information_gathering",
      "source_comparison",
      "architecture alternatives",
      "failure mode discovery",
      "contradiction search",
      "design peer review",
      "competitive and platform research",
      "media workflow review",
      "TikTok Shop product and creative strategy review",
      "subordinate result synthesis",
      "postmortem and remediation planning"
    ],
    "avoid_spending_compute_on": [
      "large boilerplate code generation",
      "mechanical formatting",
      "simple deterministic transforms",
      "bulk file rewrites",
      "tasks with a reliable local tool oracle"
    ],
    "coding": {
      "default_mode": "REVIEW_PLAN_AND_PATCH_GUIDANCE",
      "bulk_code_generation_by_default": false,
      "direct_repository_write": false,
      "may_review_large_patches": true,
      "may_generate_small_targeted_patch": true,
      "prefer_delegate_large_implementation_to_specialist": true
    }
  },
  "research_fanout": {
    "pattern": "CHATGPT_TO_DEEPSEEK_SUPERVISOR_TO_BOUNDED_RESEARCH_LANES_TO_DEEPSEEK_SYNTHESIS_TO_CHATGPT_ADJUDICATION",
    "max_distinct_research_lanes": 8,
    "max_parallel_deepseek_calls": 4,
    "max_deepseek_calls_per_mission": 12,
    "successful_lane_is_never_repeated_without_new_evidence": true,
    "failed_lane_retry_limit": 1,
    "same_root_cause_retry": false,
    "final_deepseek_synthesis_call": true,
    "chatgpt_final_adjudication_required": true
  },
  "reasoning_effort": {
    "routing_and_light_triage": "low",
    "normal_research_and_peer_review": "high",
    "architecture_incident_and_red_team": "max",
    "do_not_use_max_for_mechanical_tasks": true
  },
  "context_and_cache": {
    "stable_shared_prefix_first": true,
    "put_canonical_policy_and_evidence_before_lane_specific_prompt": true,
    "lane_specific_instruction_after_shared_prefix": true,
    "reuse_identical_prefixes_to_maximize_provider_context_cache_hits": true,
    "send_artifact_refs_instead_of_repeating_large_raw_outputs": true,
    "distilled_lane_result_only": true,
    "no_hidden_scratchpad_required_in_handoff": true
  },
  "budget": {
    "guard_pricing_basis": "CURRENT_OFFICIAL_PEAK_RATE",
    "max_estimated_cost_usd_per_mission": 0.50,
    "max_estimated_cost_usd_per_day": 3.00,
    "max_output_tokens_per_research_lane": 8192,
    "max_output_tokens_for_supervisor_synthesis": 12288,
    "stop_before_estimated_budget_exceeded": true,
    "auto_top_up": false,
    "nonurgent_batch_prefers_off_peak": true,
    "urgent_user_request_runs_immediately": true,
    "pricing_per_million_usd": {
      "off_peak": {
        "prompt_cache_hit": 0.007,
        "prompt_cache_miss": 0.22,
        "output": 0.66
      },
      "peak": {
        "prompt_cache_hit": 0.014,
        "prompt_cache_miss": 0.44,
        "output": 1.32
      }
    }
  },
  "quality_contract": {
    "deepseek_advice_is_not_ground_truth": true,
    "source_tiers": ["PRIMARY", "PEER_REVIEWED_OR_OFFICIAL_RESEARCH", "REPUTABLE_SECONDARY", "HEURISTIC"],
    "separate_facts_from_inference": true,
    "identify_conflicting_evidence": true,
    "propose_remove_or_demote_not_only_add": true,
    "recommend_measurable_tests_and_metrics": true,
    "chatgpt_checks_primary_sources_before_policy_adoption": true,
    "machine_oracle_over_model_vote_when_available": true
