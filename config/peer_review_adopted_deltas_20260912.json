  "rejected_or_deferred": [
    {
      "proposal": "Hardcode numeric multi-agent admission thresholds such as 40 percent parallelizable work or 0.75 baseline score",
      "decision": "DEFER",
      "reason": "Useful as candidate metrics but thresholds were heuristic; calibrate on fixed regression missions first."
    },
    {
      "proposal": "Remove or weaken the monolithic long-form render prohibition",
      "decision": "REJECT",
      "reason": "Conflicts with explicit permanent user reliability standard and increases blast radius."
    },
    {
      "proposal": "Run ASR on every scene",
      "decision": "REJECT",
      "reason": "Known VOICEVOX narration already has authoritative audio duration and narration manifest; mandatory ASR would add cost and failure surface."
    },
    {
      "proposal": "Make loudnorm two-pass mandatory for every file",
      "decision": "REJECT",
      "reason": "Keep measure-first normalization; avoid unnecessary processing when audio already meets calibrated target."
    },
    {
      "proposal": "Replace hard delegation ceilings with fully unconstrained dynamic fanout",
      "decision": "REJECT",
      "reason": "Dynamic concurrency is adopted only below hard safety ceilings to preserve bounded autonomy."
    },
    {
      "proposal": "Use multi-agent debate or majority vote for mechanical validation",
      "decision": "REJECT",
      "reason": "Machine oracles such as schema validators, ffprobe, hashes and tests are cheaper and more reliable."
    },
    {
      "proposal": "Treat TikTok hook style, safe zones or subtitle timing as fixed universal creative truths",
      "decision": "REJECT",
      "reason": "Platform UI and audience behavior change; use current-layout checks and A/B tests."
    }
