{
  "schema_version": "agent-org-chart-v1",
  "effective_date_jst": "2026-09-12",
  "status": "PERMANENT_STANDARD",
  "source_of_truth": true,
  "principles": {
    "centralized_control": true,
    "single_writer": true,
    "peer_mesh_default": false,
    "agent_count_is_not_success_metric": true,
    "machine_oracle_over_agent_vote_when_available": true
  },
  "layers": [
    {
      "depth": 0,
      "rank": "TOP_COMMANDER",
      "role": "chatgpt-work",
      "responsibilities": [
        "final_adjudication",
        "mission_strategy",
        "authorization_boundary",
        "system_integration",
        "accept_or_reject_supervisor_recommendations"
      ]
    },
    {
      "depth": 1,
      "rank": "EXECUTIVE_SUPERVISOR",
      "role": "paid-deepseek-supervisor",
      "policy": "config/deepseek_paid_supervisor_policy.json",
      "responsibilities": [
        "broad_research",
        "source_comparison",
        "architecture_review",
        "red_team_review",
        "incident_analysis",
        "strategy_generation",
        "task_decomposition",
        "subordinate_result_review",
        "media_strategy",
        "commerce_strategy"
      ],
      "not_default_for": [
        "bulk_boilerplate_coding",
        "repetitive_mechanical_edits",
        "deterministic_validation",
        "direct_repository_write"
      ]
    },
    {
      "depth": 2,
      "rank": "SPECIALIST_OR_WORKER",
      "roles": [
        "verified-qwen-worker",
        "verified-nvidia-worker",
        "verified-groq-worker",
        "verified-google-specialist",
        "deterministic-python-tool",
        "ffmpeg-ffprobe-tool"
      ],
      "responsibilities": [
        "bounded_execution",
        "coding_when_assigned",
        "data_extraction",
        "mechanical_transforms",
        "media_processing",
        "independent_specialist_review"
      ],
      "route_requires_current_capability_verification": true
    }
  ],
  "delegation": {
    "max_depth": 2,
    "worker_to_worker_delegation": false,
    "mutable_output_has_one_owner": true,
    "parallel_work_requires_disjoint_or_read_only_scope": true,
    "dependency_join_before_parent_completion": true
  },
  "escalation": {
    "paid_provider_other_than_preauthorized_deepseek": "HUMAN_APPROVAL",
    "production_deploy": "HUMAN_APPROVAL",
    "publish": "HUMAN_APPROVAL",
    "pr_merge": "HUMAN_APPROVAL",
    "secret_mutation_or_disclosure": "HUMAN_APPROVAL",
    "irreversible_external_action": "HUMAN_APPROVAL",
    "major_policy_conflict": "CHATGPT_TOP_COMMANDER_RECONCILIATION"
  }
}
