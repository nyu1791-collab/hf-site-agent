    "target_duration_is_content_driven_not_fixed": true,
    "news_explainer_duration_starting_heuristic_minutes": [6, 10],
    "duration_heuristic_is_not_a_mandate": true,
    "padding_by_rephrasing_or_repetition": false,
    "typical_longform_chapter_count_starting_range": [8, 12],
    "chapter_count_is_not_a_hard_rule": true
