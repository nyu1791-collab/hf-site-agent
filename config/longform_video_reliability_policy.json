    "monolithic_longform_render": false,
    "default_stage_order": ["research", "fact_check", "structure", "deepseek_review_when_high_value", "script_lock", "visual_asset_collection", "voice_generation", "subtitle_timeline", "scene_render", "checkpoint", "concat", "mechanical_qa", "artifact_handoff"]
  },
  "content_design": {
    "theme_audience_purpose_orientation_voice_cast_caption_style_visual_source_and_chapter_plan_before_render": true,
