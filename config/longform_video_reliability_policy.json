    "retry_profiles": {
      "FREE_ROUTE_429": "HONOR_RETRY_AFTER_ELSE_EXPONENTIAL_BACKOFF_WITH_JITTER_AND_REDUCE_CONCURRENCY",
      "FREE_ROUTE_5XX": "BOUNDED_EXPONENTIAL_BACKOFF_WITH_JITTER",
      "TEMPORARY_NETWORK_TIMEOUT": "SHORT_BOUNDED_RETRY_THEN_ROUTE_OR_METHOD_CHANGE",
      "TEMPORARY_DOWNLOAD_INTERRUPTION": "RESUME_OR_REDOWNLOAD_ONLY_FAILED_ASSET_WHEN_SUPPORTED"
    },
    "method_change_classes": ["IMAGE_FORMAT_INCOMPATIBLE", "ASSET_404_403", "REPEATED_FFMPEG_FILTER_FAILURE", "UNSAFE_MEDIA_CONTRACT_MISMATCH"],
    "normalization_classes": ["SAFE_MEDIA_CONTRACT_MISMATCH"],
