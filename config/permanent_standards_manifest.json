{
  "schema_version": "permanent-standards-manifest-v2",
  "effective_date_jst": "2026-09-12",
  "purpose": "Make critical AI Army, paid DeepSeek supervisor, long-form video, authorized clipping, TikTok Shop commerce, and measurable efficiency rules recoverable and reusable across new chat tabs/sessions without relying on transient conversation context.",
  "canonical_branch": "ai-army/provider-v3",
  "startup_rule": "READ_CURRENT_COMMANDER_HANDOFF_AND_REQUIRED_STANDARDS_BEFORE_PLANNING_OR_EXECUTION",
  "required_standards": [
    {
      "id": "current-commander-handoff",
      "machine_policy": "config/current_commander_handoff.json",
      "priority": 0
    },
    {
      "id": "ai-army-org-chart",
      "machine_policy": "config/ai_army_org_chart.json",
      "priority": 1
    },
    {
      "id": "multi-agent-operating-standard",
      "path": "docs/MULTI_AGENT_OPERATING_STANDARD.md",
      "machine_policy": "config/multi_agent_operating_policy.json",
      "priority": 1
    },
    {
      "id": "deepseek-executive-supervisor",
      "machine_policy": "config/deepseek_paid_supervisor_policy.json",
      "runtime": "scripts/deepseek_supervisor_research.py",
      "priority": 1
    },
    {
      "id": "agent-efficiency-shadow-evaluation",
      "machine_policy": "config/agent_efficiency_policy.json",
      "admission": "scripts/agent_architecture_admission.py",
      "evaluation": "scripts/agent_efficiency_eval.py",
      "priority": 1
    },
    {
      "id": "peer-review-adjudication",
      "machine_policy": "config/peer_review_adopted_deltas_20260912.json",
      "priority": 1
    },
    {
      "id": "longform-video-objectives",
      "path": "docs/LONGFORM_VIDEO_OBJECTIVES.md",
      "machine_policy": "config/longform_video_objectives.json",
      "priority": 1
    },
    {
      "id": "longform-video-reliability",
      "path": "docs/LONGFORM_VIDEO_RELIABILITY_PLAYBOOK.md",
      "machine_policy": "config/longform_video_reliability_policy.json",
      "priority": 1
    },
    {
      "id": "authorized-clipping-and-monetization",
      "path": "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md",
      "machine_policy": "config/authorized_clipping_monetization_policy.json",
      "priority": 1
    },
    {
      "id": "tiktok-shop-influence",
      "path": "docs/TIKTOK_SHOP_INFLUENCE_PLAYBOOK.md",
      "machine_policy": "config/tiktok_shop_influence_policy.json",
      "priority": 1
    }
  ],
  "default_runtime_flags": {
    "FREE_ONLY_MODE": true,
    "ALLOW_PAID_MODEL": false,
    "ALLOW_PAID_FALLBACK": false,
    "AUTO_TOP_UP": false,
    "scope": "DEFAULT_FOR_ALL_ROUTES_EXCEPT_EXPLICIT_PREAUTHORIZED_PAID_EXCEPTIONS"
  },
  "preauthorized_paid_exceptions": [
    {
      "provider": "deepseek",
      "role": "EXECUTIVE_SUPERVISOR",
      "policy": "config/deepseek_paid_supervisor_policy.json",
      "persistent_authorization": true,
      "repeat_per_call_approval_required": false,
      "allowed_scope": ["RESEARCH", "ARCHITECTURE", "PEER_REVIEW", "RED_TEAM", "INCIDENT_ANALYSIS", "STRATEGY", "TASK_DECOMPOSITION", "SUBORDINATE_REVIEW", "MEDIA_STRATEGY", "TIKTOK_SHOP_STRATEGY"],
      "bulk_coding_worker": false,
      "repository_write_by_deepseek": false,
      "auto_top_up": false,
      "generic_paid_fallback": false,
      "paid_media_generation": false,
      "deploy": false,
      "publish": false,
      "merge": false,
      "secret_mutation_or_disclosure": false,
      "other_paid_provider_authorization": false
    }
  ],
  "human_approval_actions": [
    "PAID_EXECUTION_NOT_MATCHING_ACTIVE_PREAUTHORIZED_EXCEPTION",
    "PAID_FALLBACK",
    "SECRET_MUTATION_OR_DISCLOSURE",
    "MAIN_DIRECT_PUSH",
    "PR_MERGE",
    "PRODUCTION_DEPLOY",
    "PUBLISH",
    "DURABLE_OBJECT_CHANGE",
    "IRREVERSIBLE_EXTERNAL_ACTION"
  ],
  "cross_tab_behavior": {
    "do_not_rely_on_chat_memory_only": true,
    "repository_files_are_durable_source_of_truth": true,
    "on_new_tab_recover_from_current_commander_handoff_first": true,
    "deepseek_supervisor_preauthorization_survives_tab_change": true,
    "deepseek_exception_does_not_expand_to_other_paid_providers": true,
    "reconfirm_current_branch_head_before_code_change": true,
    "reconfirm_pr_state_before_code_change": true,
    "do_not_assume_previous_live_provider_evidence_is_fresh": true,
    "do_not_assume_previous_quota_evidence_is_fresh": true,
    "do_not_assume_platform_commerce_policy_is_fresh": true
  },
  "failure_contract": {
    "schema": "schemas/agent_failure_event.schema.json",
    "failure_class_required_on_non_success": true,
    "termination_reason_required_on_non_success": true,
    "same_root_cause_retry_without_new_evidence": false
  },
  "longform_video_primary_goal": "DELIVER_A_PLAYABLE_FINISHED_VIDEO_WITH_MINIMUM_REWORK",
  "multi_agent_primary_goal": "USE_HIERARCHICAL_SPECIALIZATION_ONLY_WHEN_SYSTEM_VALUE_EXCEEDS_COORDINATION_COST",
  "deepseek_primary_goal": "SPEND_PAID_DEEPSEEK_COMPUTE_ON_HIGH_VALUE_SUPERVISORY_RESEARCH_REVIEW_AND_SYNTHESIS_NOT_MECHANICAL_WORK",
  "commerce_primary_goal": "USE_CURRENT_EVIDENCE_AND_STORYTELLING_TO_IMPROVE PURCHASE_UNDERSTANDING_AND_TRUST_WITHOUT_FABRICATED_CLAIMS",
  "forbidden_drift": [
    "TURN_AI_ARMY_INTO_UNBOUNDED_SWARM",
    "BROADCAST_FULL_CONTEXT_TO_EVERY_AGENT",
    "ALLOW_WORKER_TO_WORKER_UNBOUNDED_DELEGATION",
    "REPLACE_TYPED_CONTRACTS_WITH_FREEFORM_CHAT",
    "USE_DEEPSEEK_AS_DEFAULT_BOILERPLATE_CODE_FACTORY",
    "ALLOW_DEEPSEEK_EXCEPTION_TO_AUTHORIZE_OTHER_PAID_PROVIDERS",
    "AUTO_TOP_UP_OR_GENERIC_PAID_FALLBACK",
    "REGENERATE_HEALTHY_VIDEO_STAGES_AFTER_ISOLATED_FAILURE",
    "RENDER_LONGFORM_VIDEO_MONOLITHICALLY_BY_DEFAULT",
    "USE_UNLICENSED_CLIPS_AS_DEFAULT_MONETIZATION_SOURCE",
    "USE_FAKE_REVIEWS_FAKE_SCARCITY_OR_UNVERIFIED_PRODUCT_CLAIMS",
    "SILENTLY_ROUTE_FREE_FAILURE_TO_PAID_MODEL_OR_SERVICE",
    "CLAIM_VIDEO_COMPLETE_BEFORE_MACHINE_GATE_PASS"
  ]
}
