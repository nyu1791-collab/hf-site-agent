      "config/authorized_clipping_monetization_policy.json",
      "docs/AUTHORIZED_CLIPPING_AND_MONETIZATION_PLAYBOOK.md",
      "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
    ],
    "restore_before_planning_or_external_calls": true,
    "if_chat_instruction_conflicts_with_repository_policy": "FOLLOW_LATEST_EXPLICIT_USER_INSTRUCTION_WITHIN_SAFETY_BOUNDARIES_AND_UPDATE_REPOSITORY_IF_IT_CHANGES_THE_PERMANENT_STANDARD",
    "write_new_durable_operating_decisions_back_to_repository": true
  },
  "active_standards": {
    "multi_agent_policy": "config/multi_agent_operating_policy.json",
    "multi_agent_standard": "docs/MULTI_AGENT_OPERATING_STANDARD.md",
    "longform_objectives": "config/longform_video_objectives.json",
