    "platform_monetization_and_copyright_permission_are_separate_gates": true,
    "source_owner_or_explicit_written_commercial_license_required": true,
    "credit_or_attribution_is_not_permission": true,
    "captions_crop_zoom_only_are_not_assumed_sufficient_transformation": true,
    "rights_manifest_required_per_source": true,
    "human_approval_required_before_third_party_publication": true,
    "fake_engagement_automation": false,
    "direct_service_revenue_preferred_before_platform_ad_revenue": true,
    "primary_first_offer": "CREATOR_OWNED_SHORT_FORM_REPURPOSING_SERVICE",
    "deepseek_research_run_id": 34682071530,
    "deepseek_research_status": "READY_2_OF_2",
    "deepseek_conservative_peak_cost_usd": 0.00693572
