    "research_synthesis": "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
  },
  "longform_fixed_rules": {
    "video_creation_not_started_by_this_mission": true,
    "voice": "VOICEVOX_ZUNDAMON_LOCAL",
    "render": "PYTHON_FFMPEG_FFPROBE",
