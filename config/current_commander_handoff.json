  "multi_agent_fixed_rules": {
    "root_controller": "chatgpt-work",
    "single_agent_baseline_first": true,
    "central_manager_default": true,
    "single_writer": true,
    "direct_worker_to_worker_delegation": false,
    "max_delegation_depth": 2,
    "max_parallel_direct_corps": 3,
    "max_parallel_subordinate_workers": 1,
    "max_tasks_per_user_request": 10,
    "bounded_retries_and_reflection": true,
    "task_lease_required_for_parallel_mutating_work": true,
    "independent_verification_for_high_impact_outputs": true,
    "majority_vote_is_not_evidence": true
  },
  "lanes": [
    "LONGFORM_VIDEO_RELIABILITY",
    "AUTHORIZED_CLIPPING_MONETIZATION",
    "MULTI_AGENT_ORCHESTRATION",
    "FAILURE_RECOVERY",
    "EVALUATION_AND_REGRESSION",
    "CONTEXT_AND_HANDOFF"
  ],
  "priority_order": [
    "CONTEXT_AND_HANDOFF",
    "FAILURE_RECOVERY",
    "AUTHORIZED_CLIPPING_MONETIZATION",
    "LONGFORM_VIDEO_RELIABILITY",
    "MULTI_AGENT_ORCHESTRATION",
    "EVALUATION_AND_REGRESSION"
  ],
  "specific_checks": [
    "new sessions restore canonical policy files before planning",
    "healthy outputs are never destroyed by downstream failures",
    "parallel workers cannot claim or mutate the same task without a lease",
    "critical side effects are blocked by pre-execution guardrails",
    "agent loops always have time, request, token or message termination conditions",
    "cache is never treated as the sole durable checkpoint store",
    "final video validation includes ffprobe and decode-level error checking when a video is eventually produced",
    "successful lanes are not needlessly re-run",
    "clipping source rights are verified before any edit enters the publishable queue",
    "platform originality eligibility and copyright permission are evaluated independently",
    "third-party monetized clips retain a human publication approval gate",
    "missing revoked or expired license blocks publishing",
    "near-duplicate mass output and engagement manipulation are blocked"
  ],
  "delivery": {
    "intermediate_to_user": false,
    "handoff_to_lower_ai": true,
    "final_summary_only": true
  },
  "repository_mutation_by_external_ai": false,
  "production_change": false,
  "main_direct_push": false,
  "pr_merge": false,
  "deploy": false,
  "publish": false,
  "secret_mutation": false
