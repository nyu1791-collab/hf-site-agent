{
  "schema_version": "top-commander-handoff-v2",
  "effective_date_jst": "2026-09-12",
  "mission_id": "ai-army-longform-reliability-20260912",
  "objective": "Preserve and improve the AI Army and long-form video production system using evidence-driven, bounded, resumable orchestration. New chat tabs or agent sessions must restore project rules from repository state instead of relying on conversational memory.",
  "continuity": {
    "portable_across_chat_tabs": true,
    "conversation_memory_is_not_source_of_truth": true,
    "repository_is_source_of_truth": true,
    "on_new_session_required_read_order": [
      "README.md",
      "config/current_commander_handoff.json",
      "config/multi_agent_operating_policy.json",
      "docs/MULTI_AGENT_OPERATING_STANDARD.md",
      "config/longform_video_objectives.json",
      "config/longform_video_reliability_policy.json",
      "docs/LONGFORM_VIDEO_RELIABILITY_PLAYBOOK.md",
      "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
    ],
    "restore_before_planning_or_external_calls": true,
    "if_chat_instruction_conflicts_with_repository_policy": "FOLLOW_LATEST_EXPLICIT_USER_INSTRUCTION_WITHIN_SAFETY_BOUNDARIES_AND_UPDATE_REPOSITORY_IF_IT_CHANGES_THE_PERMANENT_STANDARD",
    "write_new_durable_operating_decisions_back_to_repository": true
  },
  "active_standards": {
    "multi_agent_policy": "config/multi_agent_operating_policy.json",
    "multi_agent_standard": "docs/MULTI_AGENT_OPERATING_STANDARD.md",
    "longform_objectives": "config/longform_video_objectives.json",
    "longform_policy": "config/longform_video_reliability_policy.json",
    "longform_playbook": "docs/LONGFORM_VIDEO_RELIABILITY_PLAYBOOK.md",
    "research_synthesis": "docs/AI_ARMY_LONGFORM_RESEARCH_SYNTHESIS_2026-09-12.md"
  },
  "longform_fixed_rules": {
    "video_creation_not_started_by_this_mission": true,
    "voice": "VOICEVOX_ZUNDAMON_LOCAL",
    "render": "PYTHON_FFMPEG_FFPROBE",
    "prohibited_freemium_video_saas": [
      "descript",
      "fal",
      "fal.ai",
      "runway",
      "veed",
      "heygen",
      "higgsfield"
    ],
    "external_video_service_requires_verified_completely_free_route": true,
    "unknown_cost_route": "BLOCK",
    "scene_first": true,
    "preserve_verified_checkpoints": true,
    "resume_smallest_failed_unit": true
  },
  "multi_agent_fixed_rules": {
    "root_controller": "chatgpt-work",
    "single_agent_baseline_first": true,
    "central_manager_default": true,
    "single_writer": true,
    "direct_worker_to_worker_delegation": false,
    "max_delegation_depth": 2,
    "max_parallel_direct_corps": 3,
    "max_parallel_subordinate_workers": 1,
    "max_tasks_per_user_request": 10,
    "bounded_retries_and_reflection": true,
    "task_lease_required_for_parallel_mutating_work": true,
    "independent_verification_for_high_impact_outputs": true,
    "majority_vote_is_not_evidence": true
  },
  "lanes": [
    "LONGFORM_VIDEO_RELIABILITY",
    "MULTI_AGENT_ORCHESTRATION",
    "FAILURE_RECOVERY",
    "EVALUATION_AND_REGRESSION",
    "CONTEXT_AND_HANDOFF"
  ],
  "priority_order": [
    "CONTEXT_AND_HANDOFF",
    "FAILURE_RECOVERY",
    "LONGFORM_VIDEO_RELIABILITY",
    "MULTI_AGENT_ORCHESTRATION",
    "EVALUATION_AND_REGRESSION"
  ],
  "specific_checks": [
    "new sessions restore canonical policy files before planning",
    "healthy outputs are never destroyed by downstream failures",
    "parallel workers cannot claim or mutate the same task without a lease",
    "critical side effects are blocked by pre-execution guardrails",
    "agent loops always have time, request, token or message termination conditions",
    "cache is never treated as the sole durable checkpoint store",
    "final video validation includes ffprobe and decode-level error checking when a video is eventually produced",
    "successful lanes are not needlessly re-run"
  ],
  "delivery": {
    "intermediate_to_user": false,
    "handoff_to_lower_ai": true,
    "final_summary_only": true
  },
  "repository_mutation_by_external_ai": false,
  "production_change": false,
  "main_direct_push": false,
  "pr_merge": false,
  "deploy": false,
  "publish": false,
  "secret_mutation": false
}
