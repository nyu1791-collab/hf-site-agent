{
  "schema_version": "openrouter-free-efficiency-policy-v1",
  "effective_date_jst": "2026-09-21",
  "status": "PERMANENT_STANDARD",
  "decision_owner": "chatgpt-top-commander",
  "purpose": "Attach the full current OpenRouter exact-free catalog as standby capacity while using the smallest effective number of models per task, normally one, and never crossing a verified free allowance or silently falling back to paid inference.",
  "user_authorization": {
    "persistent_free_only_authorization": true,
    "authorized_scope": "OPENROUTER_EXACT_FREE_MODELS_ONLY",
    "repeat_per_call_approval_required": false,
    "paid_models_authorized_by_this_policy": false,
    "paid_fallback_authorized": false,
    "auto_top_up_authorized": false
  },
  "connection": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "one_account_connection_serves_all_models": true,
    "model_catalog_url": "https://openrouter.ai/api/v1/models",
    "dynamic_attach_rule": "ALL_CURRENT_CATALOG_MODELS_WITH_EXACT_COLON_FREE_ID_AND_ZERO_PROMPT_AND_COMPLETION_PRICE",
    "generic_free_router_allowed": false,
    "generic_free_router_id": "openrouter/free",
    "fixed_paid_sibling_substitution": false,
    "provider_allow_fallbacks": false,
    "catalog_watch_does_not_consume_model_quota": true,
    "attach_does_not_require_model_inference": true
  },
  "execution": {
    "default_strategy": "SINGLE_BEST_FIT_MODEL",
    "default_active_models_per_task": 1,
    "routine_all_model_parallel_fanout": false,
    "routine_best_of_n_benchmark_fanout": false,
    "parallel_duplicate_agents_for_majority_vote": false,
    "one_model_may_serve_multiple_roles_when_it_is_best_fit": true,
    "second_model_allowed_only_for": [
      "PRIMARY_MODEL_UNAVAILABLE_OR_RATE_LIMITED",
      "PRIMARY_MODEL_FAILED_ACCEPTANCE_CRITERIA",
      "PRIMARY_MODEL_LACKS_REQUIRED_MODALITY_OR_TOOL_CAPABILITY",
      "HIGH_IMPACT_INDEPENDENT_VERIFICATION_MATERIALLY_REDUCES_RISK"
    ],
    "fallback_order": "SEQUENTIAL_BY_ROLE_FIT_THEN_LATENCY_THEN_TOKEN_EFFICIENCY",
    "default_parallel_openrouter_models_per_task": 1,
    "maximum_parallel_openrouter_models_per_task": 2,
    "maximum_parallel_two_requires_independent_workstreams": true,
    "stop_after_first_acceptable_result": true,
    "failed_same_method_retry_without_change": false,
    "deterministic_tool_bypass_preferred_when_sufficient": true
  },
  "quota": {
    "public_free_account_daily_cap_requests": 50,
    "public_ten_dollar_credit_daily_cap_requests": 1000,
    "public_rpm_cap_requests": 20,
    "unverified_account_daily_hard_stop_requests": 45,
    "verified_ten_dollar_account_daily_hard_stop_requests": 900,
    "local_rpm_hard_stop_requests": 15,
    "account_tier_or_credit_eligibility_must_be_verified_before_using_900_hard_stop": true,
    "unknown_account_eligibility_uses_45_hard_stop": true,
    "failed_requests_are_budgeted": true,
    "request_reserved_before_send": true,
    "http_429_opens_circuit_breaker": true,
    "paid_fallback_on_quota_exhaustion": false,
    "free_quota_exhaustion_action": "PAUSE_OPENROUTER_FREE_ROUTE_AND_USE_DETERMINISTIC_OR_OTHER_SEPARATELY_AUTHORIZED_ROUTE",
    "automatic_retry_after_429": false
  },
