{
  "schema_version": "ymm4-research-explainer-profile-v1",
  "effective_date_jst": "2026-09-25",
  "status": "PREPRODUCTION_BLUEPRINT",
  "purpose": "Capture the look and reusable production shape of the user-supplied longform explainer reference without copying its factual claims or media.",
  "source_reference": {
    "kind": "USER_SUPPLIED_SCREEN_RECORDING",
    "displayed_player_runtime": "19:06",
    "observations_are_style_only": true,
    "reference_is_fact_source": false,
    "reuse_reference_video_assets": false,
    "style_observations": [
      "A short two-character exchange begins the explanation before a compact chapter card.",
      "The chapter label sits at the upper left.",
      "The two characters frame the center visual area, with the current speaker receiving focus and the listener remaining visible.",
      "A bright softly blurred background keeps dialogue and central evidence readable.",
      "Short white captions sit in a compact dark rounded panel; speaker name tabs carry green and pink identity colors.",
      "A few manually selected phrases receive a red highlight.",
      "A narrow lower strip identifies sources relevant to the current subject."
    ]
  },
  "applies_to": "CLAIM_BEARING_LONGFORM_NEWS_OR_SCIENCE_EXPLAINERS",
  "editor": "YMM4",
  "local_baseline_project_name": "ZUNDAMON_METAN_RESEARCH_LONGFORM_BASE.ymmp",
  "baseline_must_be_created_and_checked_on_windows": true,
  "canvas": {
    "orientation": "LANDSCAPE",
    "default_aspect_ratio": "16:9",
    "resolution": [
      1920,
      1080
    ],
    "frame_rate": 30,
    "verify_against_actual_source_master_before_locking": true
  },
  "duration": {
    "default_target_minutes": [
      8,
      12
    ],
    "content_driven": true,
    "padding_allowed": false,
    "use_reference_player_runtime_as_default": false,
    "may_exceed_default_when_source_supported_story_requires_it": true
  },
  "composition": {
    "character_positions": {
      "ずんだもん": "RIGHT",
      "四国めたん": "LEFT"
    },
    "normalize_perceived_character_size_before_speaker_focus": true,
    "active_speaker_scale_starting_range": [
      1.06,
      1.12
    ],
    "listener_scale_starting_range": [
      0.98,
      1
    ],
    "listener_remains_visible_when_context_or_reaction_matters": true,
    "voice_synchronized_mouth_and_sparse_semantic_expression": true,
    "this_is_a_scoped_exception_to_static_turn_focus_only": true,
    "constant_zoom_or_aimless_motion": false,
    "one_attention_hero_per_semantic_beat": true
  },
  "visual_style": {
    "background": "BRIGHT_LOW_DETAIL_SOFT_FOCUS_OR_RELEVANT_EVIDENCE_VISUAL",
    "chapter_card": "COMPACT_ORANGE_LABEL_AT_UPPER_LEFT",
    "central_visual_area": "OFFICIAL_OR_RIGHTS_VERIFIED_SOURCE_MATCHED_DIAGRAM_OR_IMAGE",
    "caption_body_color": "WHITE",
    "caption_panel": "COMPACT_TRANSLUCENT_DARK_ROUNDED_PANEL",
    "avoid_oversized_near_black_caption_box": true,
    "speaker_nameplate_colors": {
      "ずんだもん": "#4DE084",
      "四国めたん": "#FF5BB9"
    },
    "special_highlighting": "EXPLICIT_MANUAL_AND_RARE",
    "special_highlight_reason_required": true,
    "color_alone_never_carries_meaning": true
  },
  "source_display": {
    "per_scene_source_ids_required_for_claim_bearing_visuals": true,
    "show_exact_source_title_and_date_when_available": true,
    "source_ledger_maps_source_to_claim_ids": true,
    "organization_names_alone_are_not_a_claim_citation": true,
    "source_strip_must_not_cover_caption_or_evidence": true,
    "full_source_list_and_claim_mapping_retained_in_sidecar": true
  },
  "chapter_outline": {
    "fixed_chapter_count": false,
    "reusable_functions": [
      "HOOK_DIALOGUE",
      "WHAT_WAS_FOUND",
      "HOW_IT_WORKS",
      "EVIDENCE_AND_CONTEXT",
      "LIMITS_OR_COUNTERPOINT",
      "IMPACT_AND_TAKEAWAY"
    ],
    "merge_split_or_remove_sections_to_fit_evidence": true,
    "no_fixed_cut_or_expression_interval": true
  },
  "item_template_names": [
    "LONGFORM/01_HOOK_DIALOGUE",
    "LONGFORM/02_CHAPTER_PILL",
    "LONGFORM/03_DIALOGUE_EVIDENCE",
    "LONGFORM/04_MECHANISM_DIAGRAM",
    "LONGFORM/05_LIMIT_OR_COMPARISON",
    "LONGFORM/06_SOURCE_STRIP",
    "LONGFORM/07_TAKEAWAY_END"
  ],
  "script_scaffold": "examples/ymm4_research_explainer_script_template.json",
  "preparation_command": "scripts/prepare_ymm4_research_explainer_package.py",
  "package_files": [
    "ymm4_script.csv",
    "ymm4_review_cues.json",
    "ymm4_chapter_sheet.json",
    "ymm4_source_claim_register.json",
    "ymm4_run_sheet.md",
    "ymm4_package_manifest.json"
  ],
  "import_contract": {
    "builtin_ymm4_csv_columns": [
      "speaker",
      "voice_text"
    ],
    "chapter_and_source_metadata_stays_in_review_sidecars": true,
    "voice_and_caption_text_are_kept_separate_for_technical_term_reading": true,
    "audio_timing_source": "MEASURED_VOICEVOX_WAV",
    "exporter_does_not_generate_audio_or_video": true,
    "caption_difference_requires_review_reason": true
  },
  "fast_creation_goal": {
    "target_wall_clock_minutes": 10,
    "status": "UNMEASURED_CONDITIONAL_TARGET",
    "scope": "A warm run from a locked source ledger and script, a checked Windows baseline, ready VOICEVOX settings, and rights-cleared cached assets; includes assembly, render, machine QA, and visual rereview.",
    "cold_start_research_or_new_rights_work_may_extend_time": true,
    "quality_rights_caption_audio_decode_and_visual_gates_must_not_be_shortened": true,
    "measurement_required_before_claiming_target_met": true
  },
  "safety": {
    "no_media_generated_by_preparation": true,
    "no_audio_generated_by_preparation": true,
    "no_ymmp_generated_outside_checked_windows_baseline": true,
    "no_network_or_paid_call_from_preparation": true,
    "do_not_publish_or_upload": true,
    "third_party_character_and_audio_assets_stay_local": true
  },
  "research_basis": [
    {
      "source": "Official YMM4 item-template and character additional-item instructions.",
      "url": "https://manjubox.net/ymm4/faq/%E3%82%86%E3%81%A3%E3%81%8F%E3%82%8A%E3%83%9C%E3%82%A4%E3%82%B9/%E5%AD%97%E5%B9%95%E3%81%A8%E4%B8%80%E7%B7%92%E3%81%AB%E3%82%AD%E3%83%A3%E3%83%A9%E3%82%AF%E3%82%BF%E3%83%BC%E3%81%AE%E5%90%8D%E5%89%8D%E3%82%84%E8%83%8C%E6%99%AF%E3%82%92%E8%A1%A8%E7%A4%BA%E3%81%97%E3%81%9F%E3%81%84/"
    },
    {
      "source": "Official YMM4 two-column script CSV import instructions.",
      "url": "https://manjubox.net/ymm4/faq/editing/%E5%8F%B0%E6%9C%AC%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB%E3%82%92%E3%82%82%E3%81%A8%E3%81%AB%E3%83%9C%E3%82%A4%E3%82%B9%E3%82%A2%E3%82%A4%E3%83%86%E3%83%A0%E3%82%92%E8%BF%BD%E5%8A%A0%E3%81%99%E3%82%8B/"
    },
    {
      "source": "Official YMM4 Ctrl+T template command and search/replace release note.",
      "url": "https://manjubox.net/ymm4/release/4.11.0.0/"
    },
    {
      "source": "Official VOICEVOX voice export, preset reuse, and phoneme timing guidance.",
      "url": "https://voicevox.hiroshiba.jp/how_to_use/"
    },
    {
      "source": "W3C prerecorded captions guidance on dialogue, speaker identity, and meaningful non-speech audio.",
      "url": "https://www.w3.org/WAI/WCAG20/Understanding/captions-prerecorded.html"
    },
    {
      "source": "Official YouTube chapter timestamps if publishing is later authorized.",
      "url": "https://support.google.com/youtube/answer/9884579?hl=en"
    }
  ]
}
