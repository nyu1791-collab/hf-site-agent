    "observations_are_style_only": true,
    "reference_is_fact_source": false,
    "reuse_reference_video_assets": false,
    "style_observations": [
      "A short exchange between the two characters begins the explanation; the first chapter label then remains in the upper-left during the chapter rather than appearing only as a transition.",
      "Zundamon appears on the right and Shikoku Metan on the left, framing the center of the screen.",
      "The active speaker is brighter and more prominent; the listener remains visible in a subdued state.",
      "The sampled center is a bright soft-focus background; a source-matched figure or diagram is a proposed evidence improvement, not an observed element of the reference.",
      "The spoken sentence is shown in full, commonly across two caption lines, in a broad rounded lower band with a white body and speaker-colored name tab.",
      "The lower source band is warm orange; it changes with the scene and prioritizes sources relevant to the current claim.",
      "A few selected phrases use red emphasis. Mouth movement follows speech and expressions change sparingly."
    ],
    "capture_is_not_output_master": true
  },
  "applies_to": "CLAIM_BEARING_LONGFORM_NEWS_OR_SCIENCE_EXPLAINERS",
