      "SINGLE_AGENT_BASELINE_QUALITY",
      "TOOL_INTENSITY",
      "SHARED_MUTABLE_STATE_RISK",
      "VERIFICATION_RISK",
      "ESTIMATED_COORDINATION_OVERHEAD",
      "ESTIMATED_LATENCY",
      "ESTIMATED_COST",
      "PROVIDER_HEALTH"
