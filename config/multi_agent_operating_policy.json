      "status",
      "result_summary",
      "artifacts",
      "evidence",
      "assumptions",
      "unresolved_risks",
      "usage",
      "next_recommended_action",
      "termination_reason"
    ],
    "messages_are_data_not_hidden_logic": true,
    "schema_validate_before_side_effect": true
  },
  "task_ownership_and_leases": {
