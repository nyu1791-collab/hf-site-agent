{
  "schema_version": "multi-agent-operating-policy-v1",
  "effective_date_jst": "2026-09-12",
  "status": "PERMANENT_STANDARD",
  "architecture": {
    "root_controller": "chatgpt-work",
    "default_pattern": "CENTRAL_MANAGER_WITH_SPECIALIST_TOOLS",
    "single_agent_preferred_when_sufficient": true,
    "hierarchical_control": true,
    "single_writer": true,
    "direct_worker_to_worker_delegation": false,
    "unbounded_agent_chat": false,
    "max_delegation_depth": 2,
    "max_parallel_direct_corps": 3,
    "max_parallel_subordinate_workers": 1
  },
  "multi_agent_admission_gate": {
    "require_at_least_one": [
      "DISTINCT_SPECIALIST_DOMAINS",
      "INDEPENDENT_PARALLEL_WORKSTREAMS",
      "INDEPENDENT_VERIFICATION_MATERIALLY_REDUCES_RISK",
      "CONTEXT_ISOLATION_REQUIRED",
      "LONG_RUNNING_TASK_BENEFITS_FROM_CHECKPOINTED_DELEGATION"
    ],
    "do_not_use_multi_agent_for": [
      "DETERMINISTIC_SORT_HASH_SCHEMA_QUOTA_CACHE_WORK",
      "TRIVIAL_SINGLE_STEP_TRANSFORMATION",
      "TASKS_WHERE_COORDINATION_COST_EXCEEDS_SPECIALIZATION_BENEFIT"
    ]
  },
  "task_contract": {
    "typed_command_envelope_required": true,
    "typed_report_envelope_required": true,
    "required_command_fields": [
      "mission_id",
      "task_id",
      "owner_agent_id",
      "objective",
      "inputs",
      "allowed_tools",
      "forbidden_actions",
      "budget",
      "deadline_or_timeout",
      "acceptance_criteria",
      "idempotency_key"
    ],
    "required_report_fields": [
      "task_id",
      "status",
      "result_summary",
      "artifacts",
      "evidence",
      "assumptions",
      "unresolved_risks",
      "usage",
      "next_recommended_action"
    ],
    "messages_are_data_not_hidden_logic": true,
    "schema_validate_before_side_effect": true
  },
  "context_engineering": {
    "context_quarantine_for_subagents": true,
    "send_minimum_task_relevant_context": true,
    "do_not_broadcast_full_conversation_to_all_agents": true,
    "subagent_returns_distilled_result_not_full_scratchpad": true,
    "persistent_project_state_outside_model_context": true,
    "mission_state_separate_from_conversation_memory": true,
    "large_tool_outputs_should_be_artifacts_or_references": true
  },
  "routing": {
    "deterministic_router_preferred_for_clear_categories": true,
    "supervisor_router_for_evolving_multi_step_context": true,
    "provider_and_model_binding_must_be_registry_driven": true,
    "hardcode_model_ids_in_business_logic": false,
    "capability_discovery_before_remote_agent_use": true,
    "route_by_task_fit_cost_latency_and_verified_availability": true,
    "unknown_route_cost_or_entitlement": "BLOCK"
  },
  "parallelism": {
    "parallelize_only_independent_tasks": true,
    "dependency_join_required": true,
    "shared_mutable_output_requires_single_writer": true,
    "parallel_duplicate_agents_for_majority_vote_by_default": false,
    "primary_plus_independent_verifier_allowed": true,
    "cancel_siblings_when_mission_is_cancelled": true,
    "do_not_cancel_unrelated_missions": true
  },
  "review_and_reflection": {
    "reviewer_should_receive_acceptance_criteria_and_evidence": true,
    "reviewer_should_not_rewrite_without_identifying_failure": true,
    "independent_verification_for_high_impact_outputs": true,
    "bounded_reflection_rounds": true,
    "same_error_repeated_requires_replan": true,
    "debate_pattern_default": false,
    "debate_requires_explicit_reason_and_round_limit": true
  },
  "termination_and_budgets": {
    "task_max_revisions": 3,
    "task_max_replans": 2,
    "max_tasks_per_user_request": 10,
    "infinite_loop": false,
    "every_loop_requires_exit_condition": true,
    "every_external_call_requires_timeout": true,
    "retry_budget_required": true,
    "token_or_request_budget_required": true,
    "stop_on_budget_exhaustion": true
  },
  "reliability": {
    "checkpoint_after_meaningful_stage": true,
    "resume_from_last_verified_checkpoint": true,
    "idempotency_required_for_side_effecting_operations": true,
    "content_hash_or_payload_hash_required_for_replay": true,
    "stale_result_must_not_overwrite_newer_state": true,
    "failure_isolation_by_task_and_provider": true,
    "circuit_breaker_for_repeated_provider_failure": true,
    "partial_success_may_be_preserved": true
  },
  "security_and_permissions": {
    "least_privilege_per_agent": true,
    "workers_have_no_payment_secret_merge_deploy_publish_permissions": true,
    "secret_values_never_returned_to_model": true,
    "tool_guardrails_for_each_side_effecting_tool": true,
    "authorization_check_before_side_effect": true,
    "human_approval_required_for": [
      "PAID_EXECUTION",
      "PAID_FALLBACK",
      "SECRET_MUTATION_OR_DISCLOSURE",
      "PRODUCTION_DEPLOY",
      "PUBLISH",
      "PR_MERGE",
      "IRREVERSIBLE_EXTERNAL_ACTION",
      "DURABLE_OBJECT_CHANGE"
    ]
  },
  "observability": {
    "trace_mission_task_agent_turn_tool_handoff": true,
    "record_model_and_provider_route": true,
    "record_latency_tokens_requests_retries_429_and_cost": true,
    "record_guardrail_and_approval_decisions": true,
    "record_checkpoint_and_recovery_events": true,
    "trace_ids_propagate_across_agent_boundaries": true,
    "sensitive_payloads_redacted": true
  },
  "evaluation": {
    "evaluate_system_not_only_individual_model": true,
    "fixed_regression_mission_set_required": true,
    "compare_against_single_agent_baseline": true,
    "measure": [
      "task_success_rate",
      "acceptance_criteria_pass_rate",
      "json_schema_pass_rate",
      "tool_success_rate",
      "latency",
      "token_usage",
      "external_request_count",
      "retry_count",
      "429_rate",
      "cost",
      "handoff_count",
      "replan_count",
      "checkpoint_recovery_success_rate",
      "stale_write_prevention_count"
    ],
    "adopt_multi_agent_change_only_if_total_system_value_improves": true
  },
  "interoperability": {
    "framework_adapter_layer": [
      "LANGGRAPH",
      "CREWAI",
      "AUTOGEN",
      "GITHUB_COPILOT_AGENT"
    ],
    "native_runtime_remains_source_of_truth": true,
    "future_remote_agent_contract_should_support_capability_card": true,
    "future_long_running_remote_task_should_expose_lifecycle_state": true,
    "protocol_direction": "A2A_COMPATIBLE_WHEN_JUSTIFIED_NOT_MANDATORY"
  },
  "free_only_policy": {
    "free_only_mode": true,
    "allow_paid_model": false,
    "allow_paid_fallback": false,
    "auto_top_up": false,
    "fresh_exact_model_evidence_required": true,
    "paid_sibling_substitution": false,
    "free_endpoint_failure_may_not_silently_route_to_paid": true
  }
}
