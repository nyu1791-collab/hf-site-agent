  },
  "routing_principles": {
    "semantic_editing": "Use multimodal AI to decide what to cut, emphasize, subtitle, reorder, or verify; use deterministic tooling to perform ordinary edits.",
    "generation": "Do not generate video for ordinary news shorts when still-image motion, public licensed imagery, captions, and audio are sufficient.",
    "multi_role": "Allow one strong free model to own adjacent tasks when this reduces handoffs without sacrificing independent final review.",
    "audit": "Prefer a different provider/model family for fact check and final multimodal audit when an equally capable verified free route exists.",
    "cost": "A route that is not freshly verified zero-cost is blocked, even if technically stronger."
  },
