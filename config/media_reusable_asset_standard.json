{
  "schema_version": "media-reusable-asset-standard-v1",
  "effective_date_jst": "2026-09-14",
  "status": "ENFORCED_STANDARD",
  "purpose": "Eliminate repeated search, repeated download and repeated layout tuning for recurring media assets while preserving rights, provenance and publish-time rechecks.",
  "principles": {
    "registered_asset_lookup_before_search": true,
    "no_repeat_search_for_registered_assets": true,
    "no_repeat_download_when_verified_cache_hit": true,
    "cache_miss_only_download": true,
    "search_reserved_for_unregistered_or_semantically_new_assets": true,
    "content_hash_receipt_required": true,
    "decode_or_archive_validation_required": true,
    "raw_third_party_assets_not_committed_to_repository": true,
    "rights_and_publish_recheck_not_bypassed_by_cache": true,
    "motion_is_generated_from_preset_not_downloaded": true,
    "layout_is_generated_from_preset_not_reinvented_per_video": true
  },
  "cache": {
    "default_root": ".media-cache/assets",
    "receipt_filename": "receipt.json",
    "max_parallel_materialization": 4,
    "reuse_order": [
      "VERIFIED_LOCAL_CACHE",
      "GITHUB_ACTIONS_CACHE",
      "KNOWN_DIRECT_SOURCE_WITH_REGISTRY_METADATA",
      "USER_DIRECTED_MANUAL_ACQUISITION_FOR_BOT_RESTRICTED_SOURCE",
      "SEARCH_DISCOVERY_ONLY_WHEN_ASSET_IS_NOT_REGISTERED_OR_NOT_SEMANTICALLY_FIT"
    ],
    "cache_identity_fields": ["asset_id", "registry_revision"],
    "cache_hit_requires_sha256_match": true,
    "cache_miss_may_fetch_known_url_without_search": true,
    "github_actions_cache_may_be_evicted": true,
    "eviction_behavior": "RE_FETCH_KNOWN_REGISTERED_URL_WITHOUT_SEARCH_AND_REBUILD_RECEIPT",
    "never_treat_cache_presence_as_publication_rights_evidence": true
  },
  "character_layout_presets": {
    "coordinate_system": "NORMALIZED_CANVAS",
    "default_series_cast": ["ずんだもん", "四国めたん"],
    "landscape_16_9": {
      "resolution": [1920, 1080],
      "dialogue_two_shot": {
        "ずんだもん": {"anchor_x": 0.23, "bottom_y": 0.95, "base_height_ratio": 0.58},
        "四国めたん": {"anchor_x": 0.77, "bottom_y": 0.95, "base_height_ratio": 0.58}
      },
      "single_speaker": {"anchor_x": 0.50, "bottom_y": 0.96, "base_height_ratio": 0.66},
      "evidence_focus_character": {"base_height_ratio": 0.44, "preferred_side_x": [0.16, 0.84]},
      "caption_safe_zone": {"center_x": 0.50, "baseline_y": 0.84, "max_width_ratio": 0.88}
    },
    "portrait_9_16": {
      "resolution": [1080, 1920],
      "dialogue_two_shot": {
        "ずんだもん": {"anchor_x": 0.30, "bottom_y": 0.92, "base_height_ratio": 0.38},
        "四国めたん": {"anchor_x": 0.70, "bottom_y": 0.92, "base_height_ratio": 0.38}
      },
      "single_speaker": {"anchor_x": 0.50, "bottom_y": 0.93, "base_height_ratio": 0.48},
      "evidence_focus_character": {"base_height_ratio": 0.31, "preferred_side_x": [0.20, 0.80]},
      "caption_safe_zone": {"center_x": 0.50, "baseline_y": 0.79, "max_width_ratio": 0.86}
    },
    "focus_scaling": {
      "active_speaker_scale_multiplier": 1.05,
      "inactive_listener_scale_multiplier": 1.00,
      "active_brightness_percent": 100,
      "inactive_brightness_percent": 80,
      "active_z_order": "FRONTMOST_CHARACTER"
    },
    "override_rule": "Use preset by default; change only when captions, evidence, crop or platform safe zones would collide."
  },
  "motion_presets": {
    "speech_start_bounce": {
      "trigger": "START_OF_EACH_SPEAKING_TURN",
      "duration_ms": 240,
      "keyframe_ms": [0, 120, 240],
      "scale_sequence": [1.0, 1.05, 1.0],
      "y_offset_canvas_ratio": [0.0, -0.012, 0.0],
      "easing": "EASE_OUT_THEN_IN"
    },
    "idle_bob": {
      "enabled": true,
      "y_amplitude_canvas_ratio": 0.004,
      "period_ms_range": [1800, 2400],
      "phase_offset_between_characters": true
    },
    "blink": {
      "enabled": true,
      "interval_ms_range": [2800, 5200],
      "closed_duration_ms_range": [90, 140],
      "deterministic_scene_seed": true
    },
    "speaker_focus_transition": {"duration_ms": 120, "switch_on_audio_turn_boundary": true},
    "expression_and_pose": {"sentence_interval_range": [1, 2], "emotion_mapping_required": true},
    "entry_exit": {
      "duration_ms": 260,
      "use_for": ["FIRST_APPEARANCE", "SCENE_RESET", "MAJOR_SECTION_CHANGE", "EVIDENCE_HANDOFF"],
      "forbid_every_line_entry_exit": true
    }
  },
