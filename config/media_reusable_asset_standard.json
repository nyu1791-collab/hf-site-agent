  "audio_reuse": {
    "source_registry": "config/free_audio_source_registry.json",
    "curated_bgm_catalog": "config/dova_curated_bgm_catalog.json",
    "prefer_already_downloaded_license_locked_asset": true,
    "bot_restricted_sources_must_not_be_scraped": true,
    "dova_programmatic_bulk_download_forbidden": true,
    "manual_or_user_directed_acquisition_may_seed_cache_once": true,
    "once_seeded_reuse_cached_copy_when_original_license_allows": true,
    "raw_audio_redistribution_forbidden": true
  },
  "fallback": {
    "registered_asset_cache_miss": "FETCH_KNOWN_URL_WITHOUT_SEARCH_IF_ACQUISITION_MODE_ALLOWS",
    "registered_asset_rights_now_unclear": "BLOCK_PUBLICATION_AND_REVERIFY_RIGHTS",
    "unregistered_asset_needed": "SEARCH_DISCOVER_VERIFY_THEN_OPTIONALLY_REGISTER_IF_REUSABLE",
    "semantic_mismatch": "DO_NOT_FORCE_CACHED_ASSET; SEARCH_FOR_BETTER_FIT"
  }
