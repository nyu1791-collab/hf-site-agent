{
  "schema_version": "direct-free-worker-corps-v1",
  "scope": "STAGING_ONLY",
  "production_enabled": false,
  "repository_write": false,
  "provider_automatic_fallback": false,
  "paid_fallback": false,
  "auto_top_up": false,
  "max_parallel_calls": 4,
  "max_total_model_calls": 15,
  "providers": {
    "zai": {
      "display_name": "Z.AI Direct",
      "base_url": "https://api.z.ai/api/paas/v4",
      "api_key_env": "ZAI_API_KEY",
      "catalog_mode": "OFFICIAL_FREE_ALLOWLIST",
      "official_free_models": [
        "glm-4.7-flash",
        "glm-4.5-flash"
      ],
      "watch_only_free_models": [
        "glm-4.6v-flash"
      ],
      "preferred_roles": [
        "CODING",
        "GENERAL",
        "JSON",
        "AGENT"
      ],
      "max_models_to_benchmark": 2,
      "max_calls": 6,
      "per_model_parallel_limit": 1,
      "thinking": {
        "JSON": false,
        "FAST": false,
        "CODING": false
      },
      "free_evidence": "OFFICIAL_PRICING_FREE"
    },
    "siliconflow": {
      "display_name": "SiliconFlow Direct",
      "base_url": "https://api.siliconflow.com/v1",
      "api_key_env": "SILICONFLOW_API_KEY",
      "catalog_mode": "LIVE_CATALOG_INTERSECT_OFFICIAL_FREE_ALLOWLIST",
      "official_free_models": [
        "Qwen/Qwen2-7B-Instruct",
        "THUDM/glm-4-9b-chat",
        "internlm/internlm2_5-7b-chat"
      ],
      "preferred_roles": [
        "BULK",
        "FAST",
        "JSON",
        "SIMPLE_CODING"
      ],
      "max_models_to_benchmark": 3,
      "max_calls": 9,
      "per_model_parallel_limit": 1,
      "balance_endpoint": "/user/info",
      "balance_observation_required": false,
      "require_non_decreasing_total_balance_for_free_verification": false,
      "free_evidence": "OFFICIAL_FREE_ALLOWLIST_PLUS_LIVE_CATALOG"
    }
  },
  "benchmark": {
    "tasks": [
      "JSON",
      "CODING",
      "FAST"
    ],
    "max_output_tokens": 320,
    "request_timeout_seconds": 60,
    "quality_floor": 0.75,
    "role_weights": {
      "JSON": 0.35,
      "CODING": 0.45,
      "FAST": 0.2
    }
  }
}
