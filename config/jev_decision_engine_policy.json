    "scope": "JEV_ROUTING_CLASSIFICATION_FANOUT_PARALLELISM_VERIFICATION_AND_LIGHTWEIGHT_RESULT_TRIAGE"
  },
  "provider": {
    "transport": "openrouter",
    "api_key_env": "OPENROUTER_API_KEY",
    "base_url": "https://openrouter.ai/api/v1",
    "canonical_model_alias": "~typesafe/jev-latest",
    "last_known_good_model": "typesafe/jev-1.13",
    "automatic_latest_migration": true,
    "latest_alias_semantics": "OPENROUTER_ALWAYS_REDIRECTS_TO_LATEST_JEV_FAMILY_MODEL",
    "current_observed_latest": "typesafe/jev-1.13",
    "current_observed_release_date": "2026-09-18",
    "minimum_context_tokens": 32000,
    "modalities": [
      "text_to_structured_decisions"
    ]
  },
  "cost_guard": {
    "current_observed_prompt_usd_per_million": 0.042,
    "current_observed_completion_usd_per_million": 0,
    "cost_is_not_primary_optimization_target_for_jev": true,
    "soft_price_observation_prompt_usd_per_million": 0.1,
    "hard_emergency_price_ceiling_prompt_usd_per_million": 1,
    "hard_emergency_price_ceiling_completion_usd_per_million": 1,
    "max_prompt_chars_per_record": 12000,
    "max_records_per_decisions_request": 20,
    "max_parallel_decision_batches": 5,
    "max_calls_per_batch_including_pinned_fallback": 2,
    "auto_top_up": false,
    "other_paid_model_fallback": false,
    "emergency_price_breach_action": "BYPASS_JEV_TO_DETERMINISTIC_OR_CHATGPT_ROUTING",
    "rationale": "JEV_IS_CHEAP_AND_ROUTING_LATENCY_VALUE_DOMINATES_SMALL_COST_VARIATION; ONLY_CATASTROPHIC_PRICE_DRIFT_BLOCKS",
    "preflight_source_order": [
      "DECISIONS_MODEL_CATALOG_WHEN_AVAILABLE",
      "AUTHORIZED_JEV_FAMILY_OBSERVED_PRICE_FROM_POLICY"
    ],
    "normal_models_catalog_is_not_authoritative_for_jev_decisions": true,
    "post_request_usage_cost_audit": true,
    "block_only_on_hard_emergency_price_evidence": true,
    "missing_normal_catalog_entry_is_not_a_block_for_authorized_jev_family": true
  },
  "intended_uses": [
    "TASK_CLASSIFICATION",
    "SPECIALIST_MODEL_ASSIGNMENT",
    "DYNAMIC_1_TO_3_FANOUT_DECISION",
    "PARALLEL_VS_SEQUENTIAL_DECISION",
    "NEED_FOR_INDEPENDENT_VERIFICATION",
    "STOP_RETRY_ESCALATE_TRIAGE",
    "LIGHTWEIGHT_POST_WORK_RESULT_TRIAGE"
  ],
  "prohibited_uses": [
    "LONG_FORM_GENERATION",
    "BULK_CODE_GENERATION",
    "OPEN_ENDED_RESEARCH",
    "FACTUAL_FINAL_ADJUDICATION",
    "PAYMENT_OR_BILLING_DECISIONS",
    "SECRET_HANDLING",
    "PR_MERGE",
    "PRODUCTION_DEPLOY",
    "PUBLICATION",
    "PERMISSION_EXPANSION"
  ],
  "decision_contract": {
    "typed_output_required": true,
    "free_text_output_allowed": false,
    "allowed_question_types": [
      "choice",
      "noul",
      "score"
    ],
    "routing_question_types": [
      "choice",
      "noul"
    ],
    "python_normalizes_final_json": true,
    "python_computes_fanout_from_selected_workers": true,
    "python_computes_execution_mode_from_typed_flags": true,
    "python_performs_all_counting_arithmetic_and_quota_math": true,
    "confidence_required": true,
    "low_confidence_threshold": 0.65,
    "second_worker_probability_threshold": 0.55,
    "third_worker_probability_threshold": 0.65,
    "parallel_probability_threshold": 0.55,
    "independent_verification_probability_threshold": 0.6,
    "low_confidence_action": "RETURN_TO_CHATGPT_OR_DETERMINISTIC_ROUTER",
    "final_authority": "chatgpt-top-commander",
    "model_may_not_expand_candidate_set": true,
    "model_may_not_expand_permissions": true,
    "model_may_not_authorize_paid_workers": true,
    "no_markdown_or_json_text_parsing": true,
    "transport_and_schema_failures_fail_closed": true
  },
  "automatic_upgrade_guard": {
    "use_latest_alias_by_default": true,
    "accept_new_latest_only_if": [
