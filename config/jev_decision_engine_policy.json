      "STRUCTURED_DECISION_SCHEMA_PASSES",
      "NO_PERMISSION_OR_CANDIDATE_EXPANSION",
      "CONFIDENCE_FIELD_VALID",
      "POST_REQUEST_USAGE_COST_AUDIT_DOES_NOT_SHOW_HARD_EMERGENCY_BREACH"
    ],
    "on_contract_failure": "RETRY_ONCE_WITH_LAST_KNOWN_GOOD_PINNED_MODEL",
    "on_pinned_failure": "FALL_BACK_TO_DETERMINISTIC_OR_CHATGPT_ROUTING",
    "silent_upgrade_without_guards": false
  },
  "observability": {
    "record_requested_alias": true,
    "record_resolved_model": true,
    "record_latency_ms": true,
    "record_usage_tokens_when_returned": true,
    "record_usage_cost_when_returned": true,
    "record_confidence": true,
    "record_fallback_reason": true,
    "secret_values_logged": false,
    "record_batch_size": true,
    "record_batch_parallelism": true,
    "record_heavy_model_calls_avoided": true,
    "record_unnecessary_fanout_avoided": true
  },
  "batch_execution": {
    "enabled": true,
    "batch_first": true,
    "max_records_per_request": 20,
    "chunk_requests_may_run_in_parallel": true,
    "max_parallel_batches": 5,
    "record_ids_stable_and_unique": true,
    "questions_prefixed_by_record_id": true,
    "one_failed_batch_does_not_cancel_healthy_batches": true,
    "failed_records_fall_back_to_deterministic_or_chatgpt_routing": true,
    "target_100_jobs": "5_DECISION_BATCHES_IN_PARALLEL_WHEN_INDEPENDENT"
  },
  "state_compaction": {
    "send_minimum_task_relevant_state": true,
    "numeric_quota_not_sent_to_jev": true,
    "quota_pressure_enum": [
      "AMPLE",
      "LIMITED",
      "CRITICAL"
    ],
    "candidate_counting_done_in_python": true,
    "full_conversation_not_sent": true,
    "free_text_worker_output_not_sent_when_typed_summary_exists": true
  }
