  "screen_grammar": {
    "allowed_scene_types": [
      "OPENING_HOOK",
      "LINEUP_OVERVIEW",
      "CHAPTER_TITLE",
      "OFFICIAL_SCREENSHOT",
      "PRODUCT_OR_UI_CAPTURE",
      "BENCHMARK_TABLE",
      "COMPARISON_CARD",
      "ORIGINAL_EXPLANATORY_DIAGRAM",
      "SUMMARY"
    ],
    "opening": {
      "max_seconds_before_main_point": 15,
      "show_main_question_and_answer_first": true,
      "avoid_long_brand_intro": true
    },
