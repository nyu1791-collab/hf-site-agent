  "screen_grammar": {
    "allowed_scene_types": [
      "OPENING_HOOK",
      "LINEUP_OVERVIEW",
      "CHAPTER_TITLE",
      "OFFICIAL_SCREENSHOT",
      "PRODUCT_OR_UI_CAPTURE",
      "BENCHMARK_TABLE",
      "COMPARISON_CARD",
      "ORIGINAL_EXPLANATORY_DIAGRAM",
      "SUMMARY"
    ],
    "opening": {
      "max_seconds_before_main_point": 15,
      "show_main_question_and_answer_first": true,
      "avoid_long_brand_intro": true
    },
    "header": {
      "persistent": true,
      "left": "series_or_video_identity",
      "center": "current_chapter_or_topic",
      "right": "compact_context_or_source_label",
      "avoid_fake_live_clock_or_broadcast_branding": true,
      "forbid_morning_show_time_of_day_elements": true
    },
    "caption": {
      "full_spoken_text": true,
      "speaker_tab_or_name_required": true,
      "max_lines_target": 3,
      "max_lines_hard": 4,
      "wide_lower_third": true,
      "pale_speaker_color": true,
      "do_not_use_word_by_word_highlighting": true
    },
    "evidence_stage": {
      "one_primary_visual_at_a_time": true,
      "crop_unnecessary_browser_or_player_chrome": true,
      "tables_and_text_must_be_legible_at_mobile_playback_size": true,
      "switch_visual_when_narrative_beat_changes": true
    },
    "pacing": {
      "reference_like_rhythm": true,
      "chapter_card_then_evidence_then_dialogue": true,
      "frequent_but_not_frenetic_visual_changes": true,
      "friendly_host_reaction_beats": true,
      "avoid_dead_static_sections": true,
      "morning_show_pacing_or_gimmicks": false
    }
  },
  "characters": {
    "required": [
      "ずんだもん",
      "四国めたん"
    ],
    "both_speak": true,
    "native_mouth_motion": true,
    "authored_expression_changes": true,
    "listener_reaction_required": true,
    "default_positioning": "四国めたん=LOWER_LEFT / ずんだもん=LOWER_RIGHT / both outside central evidence stage",
    "active_speaker_emphasis": "SMALL_SCALE_OR_OPACITY_CHANGE_ONLY",
    "do_not_block_primary_visual": true
  },
  "editorial_visual_sync": {
    "question_answer_reaction_pattern_preferred": true,
    "visual_change_per_semantic_beat": true,
    "chapter_title_card_seconds_range": [
      1,
      2.5
    ],
    "lineup_card_optional": true,
    "benchmark_or_table_zoom_to_relevant_rows": true,
    "official_source_visuals_first": true,
    "original_diagrams_for_explanation_not_fake_evidence": true
  },
  "speed_first": {
    "creation_wall_clock_target_minutes": 5,
    "quality_weight": 0.2,
    "speed_weight": 0.8,
    "reuse_layout_and_character_variants": true,
    "reuse_cached_official_visuals": true,
    "no_routine_preview": true,
    "no_cosmetic_rerender": true,
    "one_final_encode": true,
    "if_only_visual_style_changes_reuse_measured_audio_and_timing": true,
    "preferred_resolution": "1280x720",
    "quality_master_only_when_explicit_or_already_cached": "1920x1080"
  },
  "acting": {
    "native_layers_required": true,
    "mouth_method": "RMS_APPROXIMATION",
    "closed_threshold": 0.014,
    "wide_threshold": 0.07,
    "window_seconds": 0.03,
    "silent_and_listener_mouth_closed": true,
    "expressions": [
      "NORMAL",
      "HAPPY",
      "SERIOUS"
    ],
    "expressions_from_authored_cues_not_topic_keyword_matching": true,
    "happiness_hold_seconds": 4,
    "no_synthetic_mouth_over_existing_mouth": true
  }
}