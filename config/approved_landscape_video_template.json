    "avoid_visual_similarity_to_reference": false,
    "background_rules": [
      "Keep the same friendly, information-rich, lightly playful AI-news atmosphere as the reference.",
      "Do not create a morning-program or breakfast-TV feeling.",
      "Use an original cool-neutral/light tech studio background with blue-gray, teal, muted lavender and cream accents.",
      "Use simple geometric or subtle circuit/grid accents instead of the reference plants and room ornaments.",
      "Keep the board, characters, captions and topic bar visually separated and instantly scannable.",
      "Do not reproduce exact badges, frames, tickers, border shapes, logos, title bars or typography."
    ],
    "mood_target": "FRIENDLY_MODERN_AI_TECH_BRIEFING",
    "reference_mood_similarity": "HIGH_EXCEPT_MORNING_SHOW_ELEMENTS",
    "exact_visual_identity_similarity": "LOW",
    "originality_rule": "Atmosphere may be close; concrete visual assets and distinctive graphic identity must remain original."
  },
