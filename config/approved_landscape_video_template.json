{
  "schema_version": "approved-landscape-video-template-v1",
  "effective_date_jst": "2026-10-05",
  "status": "USER_DIRECTED_LONGFORM_BASELINE",
  "purpose": "Landscape AI-news/explainer videos that strongly adopt the reference video's pacing, information density, host/evidence/subtitle hierarchy and friendly tech-news atmosphere, while keeping the actual background, graphic assets, frame geometry and typography original.",
  "reference_abstraction": {
    "reference_media": "user-provided 174662.mp4",
    "copy_prohibited": true,
    "extract_only": [
      "persistent top program/section header",
      "large central evidence/content stage",
      "characters anchored outside the evidence stage",
      "wide bottom dialogue/caption zone with clear speaker identity",
      "persistent compact source/footer information",
      "chapter cards, lineup cards, evidence screenshots and comparison tables as distinct scene types",
      "consistent visual hierarchy and repeated screen grammar"
    ],
    "must_not_copy": [
      "orange/yellow news palette",
      "cream framed background",
      "plant/decorative motifs",
      "exact border geometry",
      "exact header/footer labels",
      "exact typography",
      "exact character placement proportions",
      "exact transitions or graphic ornaments"
    ],
    "atmosphere_similarity_desired": true,
    "atmosphere_to_adopt": [
      "approachable weekly AI-news / tech-briefing feeling",
      "playful but organized presentation",
      "two-character conversational hosting",
      "central evidence-first storytelling",
      "clean chapter-to-chapter rhythm",
      "compact broadcast-like information structure without morning-show framing"
    ],
    "copy_boundary": "Match the overall tech-news mood, pacing, friendliness, information hierarchy, information density and two-host presentation feel. Do not reproduce the morning-program framing or identifiable background art, exact palette, decorative motifs, logos, title bars, borders or brand identity.",
    "must_not_adopt": [
      "morning-show or breakfast-program framing",
      "fake clock or time-of-day presentation",
      "morning greeting language",
      "breakfast-TV style labels or jingles",
      "reference background art, plants, ornaments, exact frames, title bars or typography"
    ]
  },
  "canvas": {
    "longform_default": {
      "width": 1280,
      "height": 720,
      "aspect_ratio": "16:9",
      "fps": 30
    },
    "speed_fallback": {
      "width": 1280,
      "height": 720,
      "aspect_ratio": "16:9",
      "fps": 30
    },
    "portrait_allowed_only_for": [
      "SHORTS",
      "REELS",
      "TIKTOK",
      "EXPLICIT_USER_REQUEST"
    ],
    "quality_master": {
      "width": 1920,
      "height": 1080,
      "aspect_ratio": "16:9",
      "fps": 30
    }
  },
  "visual_identity": {
    "name": "AI Tech Briefing Studio",
    "background": "ORIGINAL_BRIGHT_TECH_STUDIO",
    "base_palette": {
      "background": "#EAF0F7",
      "panel": "#FFFFFF",
      "header": "#17233A",
      "line": "#CBD6E4",
      "primary_accent": "#5A7DFF",
