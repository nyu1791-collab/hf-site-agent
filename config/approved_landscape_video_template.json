  "editorial_visual_sync": {
    "question_answer_reaction_pattern_preferred": true,
    "visual_change_per_semantic_beat": true,
    "chapter_title_card_seconds_range": [
      1,
      2.5
    ],
    "lineup_card_optional": true,
    "benchmark_or_table_zoom_to_relevant_rows": true,
    "official_source_visuals_first": true,
    "original_diagrams_for_explanation_not_fake_evidence": true
  },
  "speed_first": {
    "creation_wall_clock_target_minutes": 5,
    "quality_weight": 0.2,
    "speed_weight": 0.8,
    "reuse_layout_and_character_variants": true,
    "reuse_cached_official_visuals": true,
    "no_routine_preview": true,
    "no_cosmetic_rerender": true,
    "one_final_encode": true,
    "if_only_visual_style_changes_reuse_measured_audio_and_timing": true
