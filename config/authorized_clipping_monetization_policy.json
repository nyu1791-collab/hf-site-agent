      "STAGE_3_SCORE_DEDUP_BOUNDARY_CUT_REFRAME_AND_CAPTION_DRAFT": ["MULTI_SIGNAL_HIGHLIGHT_SCORING", "CANDIDATE_DEDUP", "DIVERSITY_SELECTION", "BOUNDARY_REFINEMENT", "ROUGH_CUT", "VERTICAL_REFRAME", "CAPTION_DRAFT", "TRANSFORMATION_LAYER_DRAFT"],
      "STAGE_4_QA_HUMAN_APPROVAL_AND_EXPORT": ["RIGHTS_AND_ORIGINALITY_QA", "TECHNICAL_MACHINE_QA", "HUMAN_APPROVAL", "EXPORT_PACKAGE", "PUBLISHING_HANDOFF", "ANALYTICS_JOIN_KEY"]
