{
  "schema_version": "framework-plugin-registry-v1",
  "policy": {
    "lazy_import_only": true,
    "package_install_forbidden": true,
    "network_probe_forbidden": true,
    "unknown_api_contract_blocks": true,
    "health_gate_required": true,
    "free_model_route_required": true,
    "native_fallback": true
  },
  "plugins": {
    "LANGGRAPH": {
      "distribution": "langgraph",
      "module": "langgraph.graph",
      "required_symbols": ["StateGraph", "START", "END"],
      "stability": "STABLE_CORE",
      "execution_profile": "DURABLE_SUBGRAPH"
    },
    "MICROSOFT_AGENT_FRAMEWORK": {
      "distribution": "agent-framework",
      "module": "agent_framework",
      "required_symbols": ["Agent"],
      "optional_symbols": ["AgentProtocol"],
      "stability": "STABLE_PUBLIC_API",
      "execution_profile": "BOUNDED_AGENT_OR_WORKFLOW"
    },
    "CREWAI": {
      "distribution": "crewai",
      "module": "crewai",
      "required_symbols": ["Agent", "Crew", "Task", "Process"],
      "stability": "STABLE_PUBLIC_API",
      "execution_profile": "BOUNDED_CREW_OR_FLOW"
    },
    "AUTOGEN": {
      "distribution": "autogen-agentchat",
      "module": "autogen_agentchat.teams",
      "required_symbols": ["SelectorGroupChat"],
      "optional_symbols": ["GraphFlow"],
      "stability": "MIXED_GRAPHFLOW_EXPERIMENTAL",
      "execution_profile": "BOUNDED_AGENTCHAT",
      "experimental_features_not_required_for_readiness": ["GraphFlow"]
    },
    "GITHUB_COPILOT": {
      "distribution": null,
      "module": null,
      "required_symbols": [],
      "stability": "EXTERNAL_CONNECTOR",
      "execution_profile": "ISSUE_SCOPED_CODING",
      "requires_external_connector_evidence": true,
      "requires_billing_safe_evidence": true
    }
  }
}
