{
  "schema_version": "free-voice-routes-v1",
  "policy": {
    "free_only": true,
    "auto_top_up": false,
    "generic_paid_fallback": false,
    "tiktok_or_editor_voice_requires_explicit_connected_surface": true,
    "unknown_voice_license_blocks": true,
    "required_credit_must_be_preserved": true,
    "voice_only_does_not_authorize_character_art": true,
    "large_runtime_download_requires_explicit_runtime_preparation": true
  },
  "route_order": [
    "VOICEVOX_ZUNDAMON_LOCAL",
    "VOICEVOX_OTHER_APPROVED_LOCAL",
    "COSYVOICE2_LOCAL_FREE",
    "KOKORO_LOCAL_FREE"
  ],
  "routes": {
    "VOICEVOX_ZUNDAMON_LOCAL": {
      "provider": "voicevox",
      "execution_surface": "LOCAL_ENGINE",
      "voice": "ずんだもん",
      "capabilities": ["japanese_tts", "speech_synthesis", "intonation_control"],
      "cost_class": "FREE_LOCAL",
      "requires": [
        "engine_present",
        "voice_library_present",
        "character_terms_verified",
        "credit_enabled"
      ],
      "credit_template": "VOICEVOX:ずんだもん",
      "character_art_authorized": false,
      "commercial_use": "ALLOWED_SUBJECT_TO_VOICEVOX_AND_CHARACTER_TERMS",
      "auto_download_engine": false
    },
    "VOICEVOX_OTHER_APPROVED_LOCAL": {
      "provider": "voicevox",
      "execution_surface": "LOCAL_ENGINE",
      "capabilities": ["japanese_tts", "speech_synthesis", "intonation_control"],
      "cost_class": "FREE_LOCAL",
      "requires": [
        "engine_present",
        "voice_library_present",
        "character_terms_verified",
        "credit_enabled"
      ],
      "credit_template": "VOICEVOX:{voice_name}",
      "character_art_authorized": false,
      "commercial_use": "ALLOWED_SUBJECT_TO_VOICEVOX_AND_CHARACTER_TERMS",
      "auto_download_engine": false
    },
    "COSYVOICE2_LOCAL_FREE": {
      "provider": "huggingface_open_model",
      "model": "FunAudioLLM/CosyVoice2-0.5B",
      "execution_surface": "LOCAL_OR_APPROVED_FREE_RUNTIME",
      "capabilities": ["japanese_tts", "speech_synthesis"],
      "cost_class": "FREE_RUNTIME_ONLY",
      "requires": ["runtime_present", "model_present", "license_verified"]
    },
    "KOKORO_LOCAL_FREE": {
      "provider": "huggingface_open_model",
      "model": "hexgrad/Kokoro-82M",
      "execution_surface": "LOCAL_OR_APPROVED_FREE_RUNTIME",
      "capabilities": ["japanese_tts", "speech_synthesis"],
      "cost_class": "FREE_RUNTIME_ONLY",
      "requires": ["runtime_present", "model_present", "license_verified"]
    }
  }
}
