{
  "schema_version": "video-creation-admission-v1",
  "effective_date_jst": "2026-09-30",
  "status": "ENFORCED_PERMANENT_STANDARD",
  "purpose": "Make every VIDEO_CREATION request restore the repository media rules before rendering, including the mandatory local VOICEVOX cast.",
  "semantic_trigger": "VIDEO_CREATION",
  "voice_contract": {
    "engine": "VOICEVOX_LOCAL",
    "primary_voice": "ずんだもん",
    "secondary_voice_when_dialogue_helps": "四国めたん",
    "standard_cast": [
      "ずんだもん",
      "四国めたん"
    ],
    "runtime_speaker_discovery_required": true,
    "actual_wav_duration_drives_timeline": true,
    "voicevox_unavailable_action": "BLOCK_BEFORE_RENDER",
    "silent_video_fallback": false,
    "runtime_bootstrap": {
      "document": "docs/VOICEVOX_RUNTIME.md",
      "launcher": "scripts/with_local_voicevox.sh",
      "start_local_engine_before_declaring_unavailable": true,
      "verify_version_speakers_and_real_wav_before_render": true,
      "keep_engine_and_consumer_in_same_execution_when_localhost_isolated": true,
      "bind_only_to_loopback": true,
      "preserve_block_if_bootstrap_or_standard_cast_still_fails": true,
      "read_runtime_guide_when_starting_or_recovering_engine": true
    }
  },
  "caption_contract": {
    "full_spoken_text_required": true,
    "every_spoken_turn_must_have_visible_caption": true,
    "caption_source_of_truth": "MEASURED_TIMING_MANIFEST_WITH_FULL_SPOKEN_TEXT",
    "summary_caption_may_not_replace_narration": true,
    "caption_coverage_ratio_minimum": 1.0,
    "caption_contract_name": "FULL_SPOKEN_TEXT",
    "speaker_colors": {
      "ずんだもん": "#B8E6C8",
      "四国めたん": "#F2C4D7"
    },
    "important_term_colors": [
      "#F6DB98",
      "#E7A6AA"
    ],
    "validator": "scripts/validate_video_caption_contract.py",
    "presentation_baseline": "config/approved_video_template.json",
    "longform_renderer": "scripts/render_reusable_longform.py",
    "renderers": {
      "shortform": "scripts/render_reusable_short.py",
      "longform": "scripts/render_reusable_longform.py"
    }
  },
  "visual_asset_contract": {
    "claim_bearing_news_requires_related_visual_plan": true,
    "search_or_registered_cache_before_render": true,
    "source_page_required": true,
    "asset_locator_required": true,
    "license_or_public_domain_state_required": true,
    "scene_or_claim_mapping_required": true,
    "semantic_match_required": true,
    "generated_factual_background_default": false,
    "unknown_rights_action": "BLOCK_BEFORE_RENDER",
    "visual_provenance_manifest_required": true,
    "renderer_reads": "config/media_reusable_asset_standard.json",
    "media_region_only_required": true,
    "whole_page_feed_login_sidebar_forbidden": true,
    "enlarge_media_without_cropping_embedded_qualifiers": true,
    "provenance_scope": "EXTERNAL_OR_REUSED_VISUAL_ASSETS_ONLY",
    "original_simple_visuals_may_use_creator_provenance": true,
    "visual_density_policy": "config/media_speed_quality_policy.json#/visual_density_contract",
    "distinct_relevant_visuals_per_main_section_minimum": 2,
    "distinct_relevant_visuals_per_main_section_target_maximum": 4
  },
  "free_execution_contract": {
    "local_voicevox_only": true,
    "paid_or_freemium_tts": false,
    "paid_media_substitution": false,
    "external_voice_provider_probe": false
  },
  "cross_tab_contract": {
    "repository_read_required_on_every_new_tab": true,
    "video_request_reopens_this_gate": true,
    "chat_memory_cannot_override": true,
    "missing_or_stale_policy_blocks_render": true
  },
  "artifact_contract": {
    "must_include_voice_timing_manifest": true,
    "must_include_voicevox_credit": true,
    "routine_output_checks_ref": "config/media_speed_quality_policy.json#/speed_first_delivery/automatic_completion_check",
    "full_decode_or_frame_sampling": "ONLY_IF_EXPORT_FAILS_OR_A_CONCRETE_USABILITY_OR_SAFETY_SIGNAL_EXISTS"
  },
  "durable_execution_contract": {
    "session_stream_resilience_policy": "config/session_stream_resilience_policy.json",
    "chat_stream_is_not_execution_authority": true,
    "durable_runner_required_when_long_running_job_would_otherwise_depend_on_one_live_chat_stream": true,
    "recover_from_repository_and_verified_artifacts_after_disconnect": true
  },
  "shortform_zundamon_news60_profile": {
    "machine_template": "config/zundamon_news60_template.json",
    "human_prompt": "docs/ZUNDAMON_NEWS60_TEMPLATE.md",
    "validator": "scripts/validate_zundamon_news60_template.py",
    "scope_seconds": [
      55,
      60
    ],
    "default_for_scoped_shortform": true,
    "measured_voicevox_timing_required": true,
    "explicit_critical_highlights_only": true,
    "voice_synchronized_mouth_and_semantic_facial_expression_required": true,
    "static_character_renderer_allowed": false,
    "applies_only_when_user_requests_or_continues_55_to_60_second_zundamon_news_short": true
  },
  "platform_delivery_contract": {
    "profile_registry": "config/video_platform_delivery_profiles.json",
    "human_playbook": "docs/VIDEO_PLATFORM_DELIVERY_PLAYBOOK.md",
    "platform_derivatives_from_clean_master_required": true,
    "advice_scope_must_be_preserved": true,
    "metric_definition_and_observation_date_required": true,
    "platform_limits_must_be_rechecked_before_upload": true,
    "unknown_analytics": "UNAVAILABLE_NOT_INVENTED",
    "applies_only_when_user_requests_platform_specific_export_or_delivery": true
  },
  "character_output_contract": {
    "native_layers_required": true,
    "measured_waveform_mouth_required": true,
    "silent_listener_mouth_closed": true,
    "authored_expression_changes_for_both_speakers": true,
    "longform_static_fallback_allowed": false,
    "final_mp4_samples_required": true,
    "longform_renderer": "scripts/render_reusable_longform.py",
    "applies_only_when_character_led_profile_is_selected_or_user_requests_it": true,
    "plain_narration_or_simple_card_video_may_omit_native_character_layers": true
  },
  "required_read_set_ref": "config/media_command_read_gate.json#/speed_first_delivery_override/read_set"
}
