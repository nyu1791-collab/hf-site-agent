[Unit]
Description=One explicitly requested reviewed media render (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hf-site-agent
Group=hf-site-agent
WorkingDirectory=/opt/hf-site-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/hf-site-agent/home
Environment=TMPDIR=/var/lib/hf-site-agent/tmp
EnvironmentFile=/etc/hf-site-agent/media-render.env
ExecStart=/usr/bin/python3 -m scripts.media_news_pipeline --db /var/lib/hf-site-agent/media-queue.sqlite3 --workspace /var/lib/hf-site-agent render --package /var/lib/hf-site-agent/media-news/%i --remote-render
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hf-site-agent
UMask=0077
TimeoutStartSec=2400
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
