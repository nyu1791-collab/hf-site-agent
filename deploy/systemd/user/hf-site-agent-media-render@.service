[Unit]
Description=One explicitly requested reviewed remote render (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hf-site-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/tmp
EnvironmentFile=%h/.config/hf-site-agent/media-render.env
ExecStart=/usr/bin/python3 -m scripts.media_news_pipeline --db %h/hf-site-agent/runtime/media-queue.sqlite3 --workspace %h/hf-site-agent/runtime render --package %h/hf-site-agent/runtime/media-news/%i --remote-render
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=2400
TimeoutStopSec=45
KillMode=control-group

# Deliberately no [Install] section: rights review and an explicit one-shot start are required.
