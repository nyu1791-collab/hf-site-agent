[Unit]
Description=Bounded loopback media render worker
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=hf-render-worker
Group=hf-render-worker
WorkingDirectory=/opt/hf-site-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/hf-render-worker/home
Environment=TMPDIR=/var/lib/hf-render-worker/tmp
EnvironmentFile=/etc/hf-render-worker/worker.env
ExecStartPre=/usr/bin/mkdir -p /var/lib/hf-render-worker/home /var/lib/hf-render-worker/tmp
ExecStart=/usr/bin/python3 -m scripts.media_render_worker --listen-host 127.0.0.1 --port 18765 --work-dir /var/lib/hf-render-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=1830
KillMode=control-group
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hf-render-worker
ReadOnlyPaths=/srv/hf-render-assets
UMask=0077

[Install]
WantedBy=multi-user.target
