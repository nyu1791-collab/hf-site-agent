{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/live-probe-plan.schema.json",
  "title": "Live Probe Plan",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "live_probe_enabled",
    "auto_execution_allowed",
    "budget",
    "plans",
    "safety",
    "final"
  ],
  "properties": {
    "schema_version": {"const": "live-probe-plan-v1"},
    "created_at": {"type": "string", "minLength": 1},
    "live_probe_enabled": {"const": false},
    "auto_execution_allowed": {"const": false},
    "budget": {
      "type": "object",
      "required": ["estimated_requests", "max_total_requests", "within_budget"],
      "properties": {
        "estimated_requests": {"type": "integer", "minimum": 0},
        "max_total_requests": {"type": "integer", "minimum": 1, "maximum": 24},
        "within_budget": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "model_source",
          "endpoint",
          "requests",
          "max_input_tokens",
          "max_output_tokens",
          "free_verified",
          "quota_verified",
          "capabilities_tested",
          "probe_gate",
          "probe_status",
          "benchmark_status",
          "candidate_selection",
          "estimated_requests",
          "estimated_tokens",
          "estimated_cost",
          "estimated_cost_status",
          "timeout_ms",
          "max_retries",
          "required_confirmation",
          "requires_explicit_approval",
          "auto_execution_allowed",
          "status"
        ],
        "properties": {
          "provider": {"enum": ["google", "nvidia", "groq", "openrouter", "modal"]},
          "model": {"type": ["string", "null"]},
          "expected_model_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "model_source": {"type": "string", "minLength": 1},
          "endpoint": {"type": ["string", "null"]},
          "requests": {"type": "integer", "minimum": 0},
          "max_input_tokens": {"type": "integer", "minimum": 0},
          "max_output_tokens": {"type": "integer", "minimum": 0},
          "free_verified": {"const": false},
          "quota_verified": {"const": false},
          "capabilities_tested": {"type": "array", "items": {"type": "string"}},
          "probe_gate": {"enum": ["BLOCKED_COST_UNKNOWN", "NOT_APPLICABLE_COMPUTE_DISABLED"]},
          "probe_status": {"const": "NOT_RUN"},
          "benchmark_status": {"enum": ["NOT_RUN", "NOT_APPLICABLE"]},
          "candidate_selection": {
            "type": "object",
            "required": ["source", "labels", "exact_model_id_required", "fixed_id_authorized"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "exact_model_id_required": {"type": "boolean"},
              "fixed_id_authorized": {"const": false}
            },
            "additionalProperties": false
          },
          "phase": {"type": "string", "minLength": 1},
          "estimated_requests": {"type": "integer", "minimum": 0},
          "estimated_tokens": {"type": "integer", "minimum": 0},
          "estimated_cost": {"const": "UNKNOWN"},
          "estimated_cost_status": {"const": "UNKNOWN"},
          "timeout_ms": {"type": "integer", "minimum": 1},
          "max_retries": {"const": 0},
          "required_confirmation": {"type": "string", "minLength": 1},
          "requires_explicit_approval": {"const": true},
          "auto_execution_allowed": {"const": false},
          "compute_jobs_included": {"type": "integer", "const": 0},
          "status": {"enum": ["READY_FOR_MANUAL_REVIEW", "BLOCKED_REQUEST_BUDGET"]}
        },
        "additionalProperties": false
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "paid_calls",
        "paid_fallback",
        "auto_top_up",
        "compute_jobs_started",
        "production_routing_changed",
        "secret_values_emitted",
        "max_retries",
        "cost_unknown_blocks_auto_execution"
      ],
      "properties": {
        "paid_calls": {"const": 0},
        "paid_fallback": {"const": false},
        "auto_top_up": {"const": false},
        "compute_jobs_started": {"const": 0},
        "production_routing_changed": {"const": false},
        "secret_values_emitted": {"const": false},
        "max_retries": {"const": 0},
        "cost_unknown_blocks_auto_execution": {"const": true}
      },
      "additionalProperties": false
    },
    "final": {
      "type": "object",
      "required": [
        "state",
        "LIVE_PROBE_GOOGLE",
        "LIVE_PROBE_NVIDIA",
        "LIVE_PROBE_GROQ",
        "LIVE_PROBE_OPENROUTER",
        "LIVE_PROBE_MODAL",
        "auto_execution_allowed"
      ],
      "properties": {
        "state": {"enum": ["LIVE_PROBE_PLAN_READY", "BLOCKED_REQUEST_BUDGET"]},
        "LIVE_PROBE_GOOGLE": {"const": false},
        "LIVE_PROBE_NVIDIA": {"const": false},
        "LIVE_PROBE_GROQ": {"const": false},
        "LIVE_PROBE_OPENROUTER": {"const": false},
        "LIVE_PROBE_MODAL": {"const": false},
        "auto_execution_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
