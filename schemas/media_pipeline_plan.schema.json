{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hf-site-agent/media-pipeline-plan.schema.json",
  "title": "Japanese short-video pipeline plan",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "rights",
    "format",
    "segments",
    "captions",
    "originality",
    "cost",
    "approval",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "rights": {
      "type": "object",
      "required": [
        "source_type",
        "permission_status",
        "attribution"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "owned",
            "licensed",
            "public_domain",
            "user_supplied"
          ]
        },
        "permission_status": {
          "enum": [
            "verified",
            "pending",
            "blocked"
          ]
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "orientation",
        "width",
        "height",
        "fps",
        "target_duration_seconds"
      ],
      "properties": {
        "orientation": {
          "const": "9:16"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "type": "number",
          "minimum": 24,
          "maximum": 60
        },
        "target_duration_seconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 180
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "start_seconds",
          "end_seconds",
          "role",
          "text"
        ],
        "properties": {
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "role": {
            "enum": [
              "hook",
              "problem",
              "evidence",
              "payoff",
              "cta",
              "b_roll"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "source_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "required": [
        "language",
        "max_lines",
        "max_chars_per_line",
        "safe_area_percent"
      ],
      "properties": {
        "language": {
          "const": "ja"
        },
        "max_lines": {
          "const": 2
        },
        "max_chars_per_line": {
          "type": "integer",
          "minimum": 8,
          "maximum": 24
        },
        "safe_area_percent": {
          "type": "object",
          "required": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "left": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            "right": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          }
        }
      }
    },
    "originality": {
      "type": "object",
      "required": [
        "source_hashes",
        "transformations",
        "similarity_check"
      ],
      "properties": {
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "similarity_check": {
          "enum": [
            "not_run",
            "flag_only",
            "review_required",
            "clear"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "provider_tier",
        "estimated_cost_jpy",
        "max_budget_jpy",
        "paid_approved",
        "stop_if_estimate_exceeds"
      ],
      "properties": {
        "provider_tier": {
          "enum": [
            "free",
            "low_cost",
            "paid_requires_approval"
          ]
        },
        "estimated_cost_jpy": {
          "type": "number",
          "minimum": 0
        },
        "max_budget_jpy": {
          "type": "number",
          "minimum": 0
        },
        "paid_approved": {
          "type": "boolean"
        },
        "stop_if_estimate_exceeds": {
          "const": true
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "required",
        "approved",
        "render_allowed"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "approved": {
          "type": "boolean"
        },
        "render_allowed": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "created_by",
        "created_at",
        "toolchain"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
