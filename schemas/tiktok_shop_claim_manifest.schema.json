{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyu1791-collab/hf-site-agent/schemas/tiktok_shop_claim_manifest.schema.json",
  "title": "TikTok Shop Claim Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "market", "product_url", "product_snapshot_hash", "policy_snapshot_hash", "claims"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "market": {"type": "string", "minLength": 2, "maxLength": 80},
    "product_url": {"type": "string", "minLength": 5, "maxLength": 2000},
    "product_snapshot_hash": {"type": "string", "minLength": 16, "maxLength": 128},
    "policy_snapshot_hash": {"type": "string", "minLength": 16, "maxLength": 128},
    "policy_rechecked_at": {"type": ["string", "null"], "format": "date-time"},
    "aigc_disclosure_required": {"type": ["boolean", "null"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "claim_type", "evidence_refs", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "claim_type": {
            "enum": ["PRODUCT_SPEC", "PRICE", "COUPON", "STOCK", "SHIPPING", "COMPARISON", "NUMERIC_PERFORMANCE", "LOCAL_REVIEW_PATTERN", "INDIVIDUAL_REVIEW", "HISTORY_OR_CULTURE", "HEALTH_OR_SAFETY", "OPINION", "OTHER"]
          },
          "evidence_refs": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "status": {"enum": ["VERIFIED", "UNVERIFIED", "EXPIRED", "CONFLICTING"]},
          "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "source_tier": {"enum": ["PRODUCT_PAGE", "MANUFACTURER_OFFICIAL", "GOVERNMENT_OR_STANDARD", "LOCAL_REVIEW_SAMPLE", "REPUTABLE_SECONDARY", "HEURISTIC", "NONE"]},
          "sample_size": {"type": ["integer", "null"], "minimum": 1},
          "original_language_retained": {"type": ["boolean", "null"]},
          "market_scope": {"type": ["string", "null"], "maxLength": 200},
          "notes": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
