{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyu1791-collab/hf-site-agent/schemas/deepseek_supervisor_mission.schema.json",
  "title": "DeepSeek Executive Supervisor Mission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "scope",
    "objective",
    "shared_evidence",
    "lanes",
    "chatgpt_final_adjudication_required",
    "max_estimated_cost_usd",
    "known_estimated_daily_spend_before_mission_usd",
    "repository_write",
    "deploy",
    "publish",
    "merge",
    "secret_mutation",
    "auto_top_up",
    "generic_paid_fallback",
    "paid_media_generation"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$"},
    "scope": {"const": "DEEPSEEK_EXECUTIVE_SUPERVISOR"},
    "objective": {"type": "string", "minLength": 10, "maxLength": 8000},
    "shared_evidence": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "oneOf": [
          {"type": "string", "maxLength": 12000},
          {
            "type": "object",
            "additionalProperties": true,
            "required": ["source", "summary"],
            "properties": {
              "source": {"type": "string", "maxLength": 2000},
              "summary": {"type": "string", "maxLength": 12000},
              "tier": {"enum": ["PRIMARY", "PEER_REVIEWED_OR_OFFICIAL_RESEARCH", "REPUTABLE_SECONDARY", "HEURISTIC"]},
              "retrieved_at": {"type": "string", "maxLength": 80}
            }
          }
        ]
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$"},
          "objective": {"type": "string", "minLength": 10, "maxLength": 8000}
        }
      }
    },
    "synthesize": {"type": "boolean", "default": true},
    "max_parallel_calls": {"type": "integer", "minimum": 1, "maximum": 4},
    "max_calls": {"type": "integer", "minimum": 1, "maximum": 12},
    "max_output_tokens_per_lane": {"type": "integer", "minimum": 256, "maximum": 8192},
    "max_output_tokens_synthesis": {"type": "integer", "minimum": 256, "maximum": 12288},
    "max_estimated_cost_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
    "known_estimated_daily_spend_before_mission_usd": {"type": "number", "minimum": 0, "maximum": 3.0},
    "expansion_reason": {"type": "string", "maxLength": 2000},
    "chatgpt_final_adjudication_required": {"const": true},
    "repository_write": {"const": false},
    "deploy": {"const": false},
    "publish": {"const": false},
    "merge": {"const": false},
    "secret_mutation": {"const": false},
    "auto_top_up": {"const": false},
    "generic_paid_fallback": {"const": false},
    "paid_media_generation": {"const": false}
  }
}
