{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hf-site-agent/commander-packet.schema.json",
  "title": "Commander handoff packet",
  "type": "object",
  "required": [
    "ok",
    "status",
    "mode",
    "authority",
    "delegated_instructions",
    "artifact",
    "handoff",
    "budget",
    "packet_sha256"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "awaiting_commander_approval"
    },
    "mode": {
      "enum": [
        "planner_critic_with_downstream_handoff",
        "commander_approved_specialist_draft"
      ]
    },
    "authority": {
      "type": "object",
      "required": [
        "commander",
        "execution_allowed",
        "required_confirmation"
      ],
      "properties": {
        "commander": {
          "type": "string",
          "minLength": 1
        },
        "execution_allowed": {
          "const": false
        },
        "required_confirmation": {
          "type": "string",
          "minLength": 1
        },
        "subagents_cannot": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delegated_instructions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/work_order"
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "type",
        "title",
        "content",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 6000
        },
        "status": {
          "const": "draft_awaiting_commander_review"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "execution_allowed"
      ],
      "properties": {
        "execution_allowed": {
          "const": false
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "provider",
        "calls",
        "max_tokens_per_call",
        "timeout_seconds",
        "automatic_fallback"
      ],
      "properties": {
        "provider": {
          "const": "openrouter"
        },
        "calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_tokens_per_call": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "automatic_fallback": {
          "const": false
        }
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "work_order": {
      "type": "object",
      "required": [
        "id",
        "role",
        "instruction",
        "execution_mode",
        "requires_commander_approval",
        "execution_allowed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "inputs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_tests": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "execution_mode": {
          "const": "read_only_draft"
        },
        "requires_commander_approval": {
          "const": true
        },
        "execution_allowed": {
          "const": false
        },
        "safety_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
