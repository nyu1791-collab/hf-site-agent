{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission-task-v1",
  "type": "object",
  "required": [
    "mission_id", "task_id", "parent_task_id", "parent_agent_id", "owner_corps", "role",
    "required_capabilities", "priority", "risk_level", "complexity_level", "deadline",
    "request_budget", "token_budget", "estimated_cost", "idempotency_key", "response_version",
    "delegation_depth", "provider_id", "depends_on", "side_effect_level"
  ],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "parent_task_id": {"type": ["string", "null"]},
    "parent_agent_id": {"type": "string", "minLength": 1},
    "owner_corps": {"enum": ["GOOGLE", "GROQ", "NVIDIA"]},
    "role": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priority": {"type": "integer", "minimum": -100, "maximum": 100},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "complexity_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "deadline": {"type": ["string", "null"]},
    "request_budget": {"type": "integer", "minimum": 1, "maximum": 1000},
    "token_budget": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "estimated_cost": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string"}]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "response_version": {"type": "integer", "minimum": 1},
    "delegation_depth": {"type": "integer", "minimum": 0, "maximum": 2},
    "provider_id": {"enum": ["google", "nvidia", "groq", "openrouter"]},
    "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "parallel_group": {"type": ["string", "null"]},
    "side_effect_level": {"enum": ["read_only", "read_only_draft", "dry_run"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
