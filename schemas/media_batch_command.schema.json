{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyu1791-collab/hf-site-agent/schemas/media_batch_command.schema.json",
  "title": "Media Batch Command Center Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "jobs"],
  "properties": {
    "schema_version": {"const": "media-batch-command-v1"},
    "output_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
    "locked_at_unix": {"type": "integer", "minimum": 0},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "input_path", "rights_verified", "start_seconds", "duration_seconds", "output_name"],
        "properties": {
          "job_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
          "input_path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rights_verified": {"type": "boolean"},
          "start_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
          "output_name": {"type": "string", "pattern": "^[^/\\\\]+\\.mp4$"},
          "layout": {"enum": ["vertical-fit", "vertical-crop", "preserve"]},
          "resource_demand": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu_slots": {"type": "integer", "minimum": 0, "maximum": 64},
              "memory_mb": {"type": "integer", "minimum": 0, "maximum": 1048576},
              "disk_mb": {"type": "integer", "minimum": 0, "maximum": 10485760},
              "provider_slots": {"type": "integer", "minimum": 0, "maximum": 64}
            }
          }
        }
      }
    }
  }
}
