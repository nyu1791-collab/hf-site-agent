{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyu1791-collab/hf-site-agent/schemas/creative_experiment.schema.json",
  "title": "Creative Experiment Contract",
  "description": "Pre-registration and validity record for video/TikTok Shop creative experiments. Observational comparisons must not be labelled causal experiments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "platform", "mode", "hypothesis", "primary_metric", "guardrails", "primary_variable", "started_at", "decision_status"],
  "properties": {
    "schema_version": {"const": "creative-experiment-v1"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "platform": {"enum": ["TIKTOK", "TIKTOK_SHOP", "YOUTUBE", "META_REELS", "OTHER"]},
    "market": {"type": ["string", "null"], "maxLength": 120},
    "mode": {"enum": ["RANDOMIZED_AB", "RANDOMIZED_ABC", "HOLDOUT_LIFT", "SEQUENTIAL_VALID", "OBSERVATIONAL"]},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4000},
    "target_funnel_stage": {"type": ["string", "null"], "maxLength": 200},
    "primary_metric": {"type": "string", "minLength": 1, "maxLength": 200},
    "guardrails": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "primary_variable": {"type": "string", "minLength": 1, "maxLength": 1000},
    "unit_of_randomization": {"type": ["string", "null"], "maxLength": 200},
    "attribution_window": {"type": ["string", "null"], "maxLength": 500},
    "planned_end_rule": {"type": ["string", "null"], "maxLength": 1000},
    "early_stopping_method": {"enum": ["NONE_FIXED_HORIZON", "PREDECLARED_SEQUENTIAL", "ALWAYS_VALID", "NOT_APPLICABLE_OBSERVATIONAL"]},
    "srm_check": {"enum": ["PASS", "FAIL", "NOT_YET_CHECKED", "NOT_APPLICABLE"]},
    "srm_resolution_note": {"type": ["string", "null"], "maxLength": 2000},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "sample_context": {"type": ["string", "null"], "maxLength": 4000},
    "confounders_recorded": {"type": "array", "maxItems": 30, "items": {"enum": ["CREATOR", "PRODUCT", "ACCOUNT", "TIME_WINDOW", "CATEGORY", "AUDIENCE", "PLACEMENT", "OFFER", "OTHER"]}},
    "lagging_guardrails_mature": {"type": ["boolean", "null"]},
    "decision_status": {"enum": ["PRE_REGISTERED", "RUNNING", "INCONCLUSIVE", "WINNER_CAUSAL", "WINNER_DIRECTIONAL_ONLY", "INVALID_SRM", "STOPPED_GUARDRAIL", "REJECTED"]},
    "decision_reason": {"type": ["string", "null"], "maxLength": 4000}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["RANDOMIZED_AB", "RANDOMIZED_ABC", "HOLDOUT_LIFT", "SEQUENTIAL_VALID"]}}},
      "then": {"required": ["unit_of_randomization", "attribution_window", "early_stopping_method", "srm_check"]}
    },
    {
      "if": {"properties": {"mode": {"const": "OBSERVATIONAL"}}},
      "then": {
        "properties": {
          "decision_status": {"enum": ["PRE_REGISTERED", "RUNNING", "INCONCLUSIVE", "WINNER_DIRECTIONAL_ONLY", "REJECTED"]},
          "early_stopping_method": {"enum": ["NOT_APPLICABLE_OBSERVATIONAL"]},
          "srm_check": {"enum": ["NOT_APPLICABLE"]}
        }
      }
    },
    {
      "if": {"properties": {"srm_check": {"const": "FAIL"}}},
      "then": {"properties": {"decision_status": {"enum": ["INVALID_SRM", "RUNNING", "INCONCLUSIVE", "REJECTED"]}}}
    }
  ]
}
