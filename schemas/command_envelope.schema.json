{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyu1791-collab/hf-site-agent/schemas/command_envelope.schema.json",
  "title": "Hierarchical Command Envelope",
  "description": "A bounded parent-to-child command. Runtime validation additionally checks registry edges and tool scopes.",
  "type": "object",
  "required": [
    "mission_id",
    "command_id",
    "parent_command_id",
    "parent_agent_id",
    "child_agent_id",
    "owner_agent_id",
    "rank",
    "role",
    "mission",
    "objective",
    "constraints",
    "inputs",
    "input_refs",
    "artifact_refs",
    "expected_output",
    "provider_preference",
    "deadline",
    "token_budget",
    "time_budget_ms",
    "request_budget",
    "tool_scope",
    "may_spawn_children",
    "allowed_child_roles",
    "depends_on",
    "parallel_group",
    "priority",
    "depth",
    "max_depth",
    "done_when",
    "permissions",
    "idempotency_key",
    "side_effect_level",
    "created_at",
    "status"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_command_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "parent_agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "child_agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "inputs": {
      "type": "object"
    },
    "input_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "expected_output": {
      "type": "object"
    },
    "provider_preference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "pattern": "^$|^[A-Za-z0-9._:-]+$"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8000
    },
    "time_budget_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "request_budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "tool_scope": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "may_spawn_children": {
      "type": "boolean"
    },
    "allowed_child_roles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "depends_on": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "parallel_group": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "priority": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "side_effect_level": {
      "enum": [
        "read_only",
        "read_only_draft",
        "dry_run",
        "mutation"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "completed_with_warnings",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "estimated_free_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  },
  "additionalProperties": true
}
